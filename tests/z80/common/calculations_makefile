CC = $(SAMESAMECVALGRIND) samesamecc
CFLAGS = -ra -mz80 -rs 3 -I ./ -I ../../common/ -I ../../../../ci/ -I ../../sms/$(notdir $(CURDIR))/ -o
LD = $(SAMESAMECVALGRIND) samesamecl
LDFLAGS = -lsms -ro 4 -v -o
OFILES = $(SFILES:.ssc=.asm)
HFILES = $(wildcard ../../common/*.ssc) $(wildcard ../../../../ci/z80_*workloads.ssc) ../../../../ci/z80_maze_maps.ssc

all: $(ROM)

$(OFILES): makefile ../../common/calculations_makefile

$(ROM): $(OFILES) makefile ../../common/calculations_makefile
	$(LD) $(LDFLAGS) $(ROM) $(OFILES)

main.asm: main.ssc $(HFILES)
	$(CC) $(CFLAGS) main.asm main.ssc

interrupts.asm: interrupts.ssc ../../sms/calculations-1/interrupts.ssc
	$(CC) $(CFLAGS) interrupts.asm interrupts.ssc

bank_%.asm: bank_%.ssc $(HFILES)
	$(CC) -b $* -s 2 $(CFLAGS) $@ $<

clean:
	rm -f $(OFILES) *~ $(ROM) *.compiler.log $(CLEANFILES)

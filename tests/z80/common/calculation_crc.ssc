u16 calculationCrc16(u8 *bytes, u16 length) {

  u16 crc = 0xFFFF;
  u16 i;
  u16 bit;

  for (i = 0; i < length; i++) {
    crc ^= bytes[i] << 8;
    for (bit = 0; bit < 8; bit++) {
      if ((crc & 0x8000) != 0)
        crc = (crc << 1) ^ 0x1021;
      else
        crc <<= 1;
    }
  }
  return crc;
}

u8 g_allocator_mul_div_mod_arg1_sink_a;
u16 g_allocator_mul_div_mod_arg1_sink_hl;

u8 allocatorRaMulArg1A(u8 left, u8 right, u8 factor, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = ((left + right) * factor) ^ mask;
  g_allocator_mul_div_mod_arg1_sink_a = out;
  __asm(".DB \"<01\"");

  return out;
}

u8 allocatorRaDivArg1A(u8 left, u8 right, u8 factor, u8 mask) {

  u8 out;

  __asm(".DB \"02>\"");
  out = ((left + right) / factor) ^ mask;
  g_allocator_mul_div_mod_arg1_sink_a = out;
  __asm(".DB \"<02\"");

  return out;
}

u8 allocatorRaModArg1A(u8 left, u8 right, u8 factor, u8 mask) {

  u8 out;

  __asm(".DB \"03>\"");
  out = ((left + right) % factor) ^ mask;
  g_allocator_mul_div_mod_arg1_sink_a = out;
  __asm(".DB \"<03\"");

  return out;
}

u16 allocatorRaMulArg1Hl(u16 left, u16 right, u16 factor, u16 mask) {

  u16 out;

  __asm(".DB \"04>\"");
  out = ((left ^ right) * factor) ^ mask;
  g_allocator_mul_div_mod_arg1_sink_hl = out;
  __asm(".DB \"<04\"");

  return out;
}

u16 allocatorRaDivArg1Hl(u16 left, u16 right, u16 factor, u16 mask) {

  u16 out;

  __asm(".DB \"05>\"");
  out = ((left ^ right) / factor) ^ mask;
  g_allocator_mul_div_mod_arg1_sink_hl = out;
  __asm(".DB \"<05\"");

  return out;
}

u16 allocatorRaModArg1Hl(u16 left, u16 right, u16 factor, u16 mask) {

  u16 out;

  __asm(".DB \"06>\"");
  out = ((left ^ right) % factor) ^ mask;
  g_allocator_mul_div_mod_arg1_sink_hl = out;
  __asm(".DB \"<06\"");

  return out;
}


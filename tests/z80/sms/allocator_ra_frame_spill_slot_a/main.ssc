u8 g_allocator_frame_values_a[256];

u8 allocatorRaFrameSpillSlotA(u8 a, u8 b, u8 c) {

  u8 d;

  __asm(".DB \"01>\"");
  g_allocator_frame_values_a[a + b] = c;
  d = (a + b) ^ c;
  __asm(".DB \"<01\"");

  return d;
}


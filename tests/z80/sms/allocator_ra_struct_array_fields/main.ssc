struct AllocatorRaStructArrayField {
  u8 pad;
  u8 byte_value;
  u16 word_value;
};

struct AllocatorRaStructArrayField g_allocator_struct_array_field_values[8];
u16 g_allocator_struct_array_field_sink_hl;

u8 allocatorRaStructArrayFieldWriteA(u8 index_left, u8 index_right, u8 value_left, u8 value_right) {

  __asm(".DB \"01>\"");
  g_allocator_struct_array_field_values[index_left + index_right].byte_value = value_left + value_right;
  __asm(".DB \"<01\"");

  return value_left;
}

u16 allocatorRaStructArrayFieldReadHl(u8 index_left, u8 index_right, u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = g_allocator_struct_array_field_values[index_left + index_right].word_value ^ mask;
  g_allocator_struct_array_field_sink_hl = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}
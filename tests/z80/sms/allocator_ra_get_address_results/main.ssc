u8 g_allocator_get_address_value;
u8 g_allocator_get_address_values[16];
u16 g_allocator_get_address_sink;

u16 allocatorRaGetAddressResultHl(u16 mask) {

  u16 out;

  __asm(".DB \"01>\"");
  out = (&g_allocator_get_address_value) ^ mask;
  g_allocator_get_address_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaGetAddressArrayResultHl(u8 index, u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = (&g_allocator_get_address_values[index]) ^ mask;
  g_allocator_get_address_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}
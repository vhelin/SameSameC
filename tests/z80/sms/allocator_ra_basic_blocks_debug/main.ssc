u8 g_basic_blocks_sink = 0;

void allocatorRaBasicBlocksSinkA(u8 value) {
  g_basic_blocks_sink = value;
}

u8 allocatorRaBasicBlocksBranchA(u8 a, u8 b, u8 c) {

  __asm(".DB \"01>\"");
  if (a + b) {
    c = c + 1;
  }
  __asm(".DB \"<01\"");

  return c;
}

u8 allocatorRaBasicBlocksCallA(u8 a, u8 b) {

  __asm(".DB \"02>\"");
  allocatorRaBasicBlocksSinkA(a + b);
  __asm(".DB \"<02\"");

  return a;
}

void main(void) {
}
u8 g_allocator_transport_byte;
u16 g_allocator_transport_word;

void allocatorRaPolicyTransportSink(u8 computed_byte, u16 computed_word, s16 signed_word, u16 unsigned_word, u8 narrowed_word, u16 constant_word) {

  g_allocator_transport_byte = computed_byte ^ narrowed_word;
  g_allocator_transport_word = computed_word ^ signed_word ^ unsigned_word ^ constant_word;
}

void allocatorRaPolicyArgumentTransport(u8 left, u8 right, u16 word_value, s8 signed_value, u8 unsigned_value) {

  __asm(".DB \"01>\"");
  allocatorRaPolicyTransportSink(left + right, word_value + 1, signed_value, unsigned_value, word_value, 0x4567);
  __asm(".DB \"<01\"");
}

void main(void) {
}

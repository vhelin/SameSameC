void allocatorRaBoundarySpillReasonSinkA(u8 value) {
}

u8 g_allocator_boundary_values_a[256];

u8 allocatorRaBoundarySpillReasonCallA(u8 a, u8 b) {

  __asm(".DB \"01>\"");
  allocatorRaBoundarySpillReasonSinkA(a + b);
  __asm(".DB \"<01\"");

  return a;
}

u8 allocatorRaBoundarySpillReasonReturnA(u8 a, u8 b) {

  __asm(".DB \"02>\"");
  if (a) {
    return a + b;
  }
  __asm(".DB \"<02\"");

  return b;
}

u8 allocatorRaBoundarySpillReasonUnmigratedA(u8 a, u8 b) {

  __asm(".DB \"03>\"");
  if (a) {
    g_allocator_boundary_values_a[a + b] = b;
    return a;
  }
  __asm(".DB \"<03\"");

  return b;
}


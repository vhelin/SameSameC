u8 allocatorRaZ80OutCRetentionAConflict(u8 port_left, u8 port_right, u8 value_left, u8 value_right) {

  __asm(".DB \"01>\"");
  __z80_out[port_left + port_right] = value_left + value_right;
  __asm(".DB \"<01\"");

  return value_left;
}


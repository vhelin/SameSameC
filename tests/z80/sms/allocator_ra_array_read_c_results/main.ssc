u8 g_allocator_array_read_bc_values[16];
u8 g_allocator_array_read_bc_target;

u8 allocatorRaArrayReadResultC(u8 index, u8 left, u8 right) {

  u8 out;

  __asm(".DB \"01>\"");
  out = g_allocator_array_read_bc_values[index] ^ (left + right);
  g_allocator_array_read_bc_target = out;
  __asm(".DB \"<01\"");

  return out;
}

u8 allocatorRaZ80InReadResultC(u8 port, u8 left, u8 right) {

  u8 out;

  __asm(".DB \"02>\"");
  out = __z80_in[port] ^ (left + right);
  g_allocator_array_read_bc_target = out;
  __asm(".DB \"<02\"");

  return out;
}

u8 allocatorRaArrayReadResultB(u8 first_index, u8 second_index, u8 left, u8 right) {

  u8 out;

  __asm(".DB \"03>\"");
    // @BT TEST-03 03 START
    // @BT DD 21 00 00 DD 19 DD 4E FB 06 00 FD 21 00 C0 FD
    // @BT 09 FD 6E 00 4D DD 4E FA 06 00 FD 21 00 C0 FD 09
    // @BT FD 6E 00 45 DD 7E F9 DD 86 F8 A8 A9 DD 77 F7 DD
    // @BT 21 10 C0 FD 21 F7 FF FD 19 FD 7E 00 DD 77 00
    // @BT END
    out = g_allocator_array_read_bc_values[first_index] ^
      (g_allocator_array_read_bc_values[second_index] ^ (left + right));
  g_allocator_array_read_bc_target = out;
  __asm(".DB \"<03\"");

  return out;
}

void main(void) {
}
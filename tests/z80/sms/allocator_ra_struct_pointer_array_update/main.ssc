struct AllocatorRaStructPointerArrayUpdateLeaf {
  u8 pad;
  u8 byte_value;
  u16 word_value;
};

struct AllocatorRaStructPointerArrayUpdateLeaf *g_allocator_struct_pointer_array_update[8];

u8 allocatorRaStructPointerArrayIncrement(u8 index_left, u8 index_right) {

  __asm(".DB \"01>\"");
  g_allocator_struct_pointer_array_update[index_left + index_right]->byte_value++;
  __asm(".DB \"<01\"");

  return index_left;
}

u16 allocatorRaStructPointerArrayDecrement(u8 index_left, u8 index_right) {

  __asm(".DB \"02>\"");
  g_allocator_struct_pointer_array_update[index_left + index_right]->word_value--;
  __asm(".DB \"<02\"");

  return index_right;
}

void main(void) {
}

u8 g_allocator_get_address_base_values[32];
u8 *g_allocator_get_address_base_pointer;
u16 g_allocator_get_address_base_sink;

u16 allocatorRaPolicyGetAddressBaseGlobal(u16 index, u16 mask) {

  u16 out;

  __asm(".DB \"01>\"");
  out = (&g_allocator_get_address_base_values[index]) ^ mask;
  g_allocator_get_address_base_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaPolicyGetAddressBasePointer(u16 index, u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = (&g_allocator_get_address_base_pointer[index]) ^ mask;
  g_allocator_get_address_base_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

u16 allocatorRaPolicyGetAddressBaseLocal(u16 index, u16 mask) {

  u8 values[16];
  u16 out;

  values[0] = 1;

  __asm(".DB \"03>\"");
  out = (&values[index]) ^ mask;
  g_allocator_get_address_base_sink = out;
  __asm(".DB \"<03\"");

  return out;
}

u16 allocatorRaPolicyGetAddressBaseFar(u16 index, u16 mask) {

  u8 padding[140];
  u8 values[16];
  u16 out;

  padding[0] = 1;
  values[0] = padding[0];

  __asm(".DB \"04>\"");
  out = (&values[index]) ^ mask;
  g_allocator_get_address_base_sink = out;
  __asm(".DB \"<04\"");

  return out;
}


u8 g_allocator_call_compare_c_sink;

u8 allocatorRaCallCompareCCallee(u8 value) {
  return value + 3;
}

u8 allocatorRaFunctionCallCompareC(u8 value, u8 left, u8 right) {

  u8 out = 0;

  __asm(".DB \"01>\"");
  // Keep a Boolean value consumer so this still exercises allocator joins.
  if ((allocatorRaCallCompareCCallee(value) == left + right) == 1)
    out = 1;
  g_allocator_call_compare_c_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

void main(void) {
}
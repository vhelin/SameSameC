u8 g_allocator_inline_asm_barrier_sink_a;
u16 g_allocator_inline_asm_barrier_sink_hl;

u8 allocatorRaInlineAsmBarrierA(u8 left, u8 right, u8 mask) {

  u8 scratch;
  u8 out;

  __asm(".DB \"01>\"");
  scratch = left + right;
  __asm("LD A,(@scratch)");
  __asm("LD (@scratch),A");
  out = scratch ^ mask;
  g_allocator_inline_asm_barrier_sink_a = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaInlineAsmBarrierHl(u16 left, u16 right, u16 mask) {

  u16 scratch;
  u16 out;

  __asm(".DB \"02>\"");
  scratch = left ^ right;
  __asm("LD HL,(@scratch)");
  __asm("LD (@scratch),HL");
  out = scratch ^ mask;
  g_allocator_inline_asm_barrier_sink_hl = out;
  __asm(".DB \"<02\"");

  return out;
}


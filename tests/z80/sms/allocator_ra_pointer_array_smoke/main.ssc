u8 g_allocator_pointer_array_smoke_sink;

u8 allocatorRaPointerArraySmoke(u8 **cursor, u8 *source, u8 index_left, u8 index_right, u8 value_left, u8 value_right, u8 mask) {

  u8 *ptr;
  u8 out;

  __asm(".DB \"01>\"");
  ptr = cursor[0];
  ptr[index_left + index_right] = value_left + value_right;
  out = source[index_left + index_right] ^ mask;
  cursor[0] = ptr + 1;
  g_allocator_pointer_array_smoke_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

void main(void) {
}
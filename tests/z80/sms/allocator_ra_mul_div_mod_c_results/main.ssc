u8 g_allocator_mul_div_mod_c_sink;

u8 allocatorRaMulDivModResultC(u8 left, u8 right, u8 a, u8 b) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (left * right) ^ (a + b);
  g_allocator_mul_div_mod_c_sink = out;
  __asm(".DB \"<01\"");

  __asm(".DB \"02>\"");
  out = (left / right) | (a & b);
  g_allocator_mul_div_mod_c_sink = out;
  __asm(".DB \"<02\"");

  __asm(".DB \"03>\"");
  out = (left % right) ^ (a | b);
  g_allocator_mul_div_mod_c_sink = out;
  __asm(".DB \"<03\"");

  return out;
}


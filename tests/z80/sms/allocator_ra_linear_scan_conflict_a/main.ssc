u8 allocatorRaLinearScanConflictA(u8 a, u8 b, u8 c, u8 d) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (a + b) + (c + d);
  __asm(".DB \"<01\"");

  return out;
}


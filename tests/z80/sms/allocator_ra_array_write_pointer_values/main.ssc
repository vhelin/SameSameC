void allocatorRaArrayWritePointerValueRetained(u8 **target, u8 *source) {

  __asm(".DB \"01>\"");
  target[0] = source + 8;
  __asm(".DB \"<01\"");
}

void allocatorRaArrayWritePointerValueStack(u8 **target, u8 *source) {

  __asm(".DB \"02>\"");
  target[1] = source;
  __asm(".DB \"<02\"");
}

void main(void) {
}

// @BT 7E FB C6 02 DD 77 FB
// @BT END

u8 g_allocator_core_cfg_sink;

void allocatorRaCoreCfgSink(u8 value) {
  g_allocator_core_cfg_sink = value;
}

u8 allocatorRaCoreCfgDiamond(u8 left, u8 right, u8 value) {

  __asm(".DB \"01>\"");
  // Keep a Boolean value consumer so this still exercises allocator joins.
  if ((left == right) == 1) {
    value = value + 1;
  }
  else {
    value = value + 2;
  }
  g_allocator_core_cfg_sink = value;
  __asm(".DB \"<01\"");

  return g_allocator_core_cfg_sink;
}

u8 allocatorRaCoreCfgLoop(u8 count, u8 value) {

  __asm(".DB \"02>\"");
  while (count + value) {
    value = value + 1;
    count = count - 1;
  }
  g_allocator_core_cfg_sink = value;
  __asm(".DB \"<02\"");

  return g_allocator_core_cfg_sink;
}

u8 allocatorRaCoreCfgBoundaries(u8 value) {

  __asm(".DB \"03>\"");
  allocatorRaCoreCfgSink(value + 1);
  __asm("nop");
  value = value + 2;
  __asm(".DB \"<03\"");

  return value;
}

void main(void) {
}

void allocatorRaBoundaryCallArgumentSinkA(u8 value) {
}

u8 allocatorRaBoundaryCallArgumentA(u8 a, u8 b) {

  __asm(".DB \"01>\"");
  allocatorRaBoundaryCallArgumentSinkA(a + b);
  __asm(".DB \"<01\"");

  return a;
}


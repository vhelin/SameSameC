u8 allocatorRaBlockExitRetainA(u8 a, u8 b, u8 c) {

  __asm(".DB \"01>\"");
  if (a + b) {
    c = c + 1;
  }
  __asm(".DB \"<01\"");

  return c;
}

u8 allocatorRaBlockExitSpillA(u8 a, u8 b) {

  __asm(".DB \"02>\"");
  if (a == b) {
    b = b + 1;
  }
  __asm(".DB \"<02\"");

  return b;
}

u16 allocatorRaBlockExitRetainHl(u16 a, u16 b, u16 c) {

  __asm(".DB \"03>\"");
  if (a + b) {
    c = c + 1;
  }
  __asm(".DB \"<03\"");

  return c;
}

u16 allocatorRaBlockExitSpillHl(u16 a, u16 b) {

  __asm(".DB \"04>\"");
  if (a == b) {
    b = b + 1;
  }
  __asm(".DB \"<04\"");

  return b;
}


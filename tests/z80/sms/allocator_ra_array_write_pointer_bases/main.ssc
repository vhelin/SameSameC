u8 allocatorRaArrayWritePointerBaseA(u8 *target, u8 left, u8 right) {

  __asm(".DB \"01>\"");
  target[0] = left + right;
  __asm(".DB \"<01\"");

  return left;
}

u16 allocatorRaArrayWritePointerBaseHl(u16 *target, u16 left, u16 right) {

  __asm(".DB \"02>\"");
  target[0] = left ^ right;
  __asm(".DB \"<02\"");

  return left;
}

void main(void) {
}

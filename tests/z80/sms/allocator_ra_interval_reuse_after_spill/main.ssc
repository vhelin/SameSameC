u8 g_allocator_interval_sink_a;
u16 g_allocator_interval_sink_hl;
u8 g_allocator_interval_values_a[256];
u16 g_allocator_interval_values_hl[256];

u8 allocatorRaIntervalReuseAfterSpillA(u8 a, u8 b, u8 c) {

  u8 out;

  __asm(".DB \"01>\"");
  g_allocator_interval_values_a[a + b] = c;
  out = (a + b) ^ c;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaIntervalReuseAfterSpillHl(u16 a, u16 b, u16 c) {

  u16 out;

  __asm(".DB \"02>\"");
  g_allocator_interval_values_hl[a + b] = c;
  out = (a + b) ^ c;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}

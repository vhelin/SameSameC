u8 g_temp_compaction_sink = 0;

u8 allocatorRaTempCompactionDebug(u8 a, u8 b, u8 c, u8 d) {

  __asm(".DB \"01>\"");
  g_temp_compaction_sink = (a + b) + c;
  g_temp_compaction_sink = (c + d) + a;
  __asm(".DB \"<01\"");

  return g_temp_compaction_sink;
}


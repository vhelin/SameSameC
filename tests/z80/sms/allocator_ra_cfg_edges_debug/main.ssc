u8 g_cfg_edges_sink = 0;

u8 allocatorRaCfgEdgesDebug(u8 a, u8 b, u8 c) {

  __asm(".DB \"01>\"");
  if (a == b) {
    c = c + 1;
  }
  else {
    c = c + 2;
  }
  g_cfg_edges_sink = c;
  __asm(".DB \"<01\"");

  return g_cfg_edges_sink;
}


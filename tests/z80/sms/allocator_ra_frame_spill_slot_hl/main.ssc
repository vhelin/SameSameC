u16 g_allocator_frame_values_hl[256];

u16 allocatorRaFrameSpillSlotHL(u16 a, u16 b, u16 c) {

  u16 d;

  __asm(".DB \"01>\"");
  g_allocator_frame_values_hl[a + b] = c;
  d = (a + b) ^ c;
  __asm(".DB \"<01\"");

  return d;
}


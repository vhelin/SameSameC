u8 g_allocator_shift_result_byte;
u16 g_allocator_shift_result_word;
u8 *g_allocator_shift_result_padding;

void allocatorRaPolicyShiftGlobalByteLeft(u8 value, u8 count) {

  __asm(".DB \"01>\"");
  g_allocator_shift_result_byte = value << count;
  __asm(".DB \"<01\"");
}

void allocatorRaPolicyShiftGlobalByteRight(u8 value, u8 count) {

  __asm(".DB \"02>\"");
  g_allocator_shift_result_byte = value >> count;
  __asm(".DB \"<02\"");
}

void allocatorRaPolicyShiftNearByteLeft(u8 value, u8 count, u8 mask) {

  u8 result;

  __asm(".DB \"03>\"");
  result = value << count;
  result = result ^ mask;
  __asm(".DB \"<03\"");
  g_allocator_shift_result_byte = result;
}

void allocatorRaPolicyShiftFarByteRight(u8 value, u8 count, u8 mask) {

  u8 padding[140];
  u8 result;

  g_allocator_shift_result_padding = &padding[139];
  __asm("NOP");
  __asm(".DB \"04>\"");
  result = value >> count;
  result = result ^ mask;
  __asm(".DB \"<04\"");
  g_allocator_shift_result_byte = result;
}

void allocatorRaPolicyShiftGlobalWordLeft(u16 value, u16 count) {

  __asm(".DB \"05>\"");
  g_allocator_shift_result_word = value << count;
  __asm(".DB \"<05\"");
}

void allocatorRaPolicyShiftGlobalWordRight(u16 value, u16 count) {

  __asm(".DB \"06>\"");
  g_allocator_shift_result_word = value >> count;
  __asm(".DB \"<06\"");
}

void allocatorRaPolicyShiftNearWordLeft(u16 value, u16 count, u16 mask) {

  u16 result;

  __asm(".DB \"07>\"");
  result = value << count;
  result = result ^ mask;
  __asm(".DB \"<07\"");
  g_allocator_shift_result_word = result;
}

void allocatorRaPolicyShiftFarWordRight(u16 value, u16 count, u16 mask) {

  u8 padding[140];
  u16 result;

  g_allocator_shift_result_padding = &padding[139];
  __asm("NOP");
  __asm(".DB \"08>\"");
  result = value >> count;
  result = result ^ mask;
  __asm(".DB \"<08\"");
  g_allocator_shift_result_word = result;
}


// @BT TEST-04 04 START
// @BT DD 21 00 00 DD 19 DD 6E F9 DD 66 FA DD 21 00 C0 DD 4E 00 DD 46 01 78 AC 67 79 AD 6F 01 0F 0F 78 A4 67 79 A5 6F DD 21 02 C0 DD 75 00 DD 74 01
// @BT END

u16 g_arithmetic_source_hl = 0x1234;
u16 g_arithmetic_target_hl = 0;

u16 allocatorRaArithmeticLocationsHl(u16 a, u16 b) {

  __asm(".DB \"01>\"");
  g_arithmetic_target_hl = a + g_arithmetic_source_hl;
  __asm(".DB \"<01\"");

  __asm(".DB \"02>\"");
  g_arithmetic_target_hl = g_arithmetic_source_hl - b;
  __asm(".DB \"<02\"");

  __asm(".DB \"03>\"");
  g_arithmetic_target_hl = g_arithmetic_source_hl | 0x8000;
  __asm(".DB \"<03\"");

  __asm(".DB \"04>\"");
  g_arithmetic_target_hl = (a ^ g_arithmetic_source_hl) & 0x0f0f;
  __asm(".DB \"<04\"");

  return g_arithmetic_target_hl;
}

void main(void) {
}
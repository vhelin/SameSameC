u8 g_allocator_array_read_index_values_a[256];
u16 g_allocator_array_read_index_values_hl[256];
u8 g_allocator_array_read_index_sink_a;
u16 g_allocator_array_read_index_sink_hl;

u8 allocatorRaArrayReadIndexA(u8 left, u8 right, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = g_allocator_array_read_index_values_a[left + right] ^ mask;
  g_allocator_array_read_index_sink_a = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaArrayReadIndexHl(u16 left, u16 right, u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = g_allocator_array_read_index_values_hl[left ^ right] ^ mask;
  g_allocator_array_read_index_sink_hl = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}

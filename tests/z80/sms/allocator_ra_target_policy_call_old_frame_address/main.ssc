u8 g_allocator_call_old_frame_sink;

void allocatorRaPolicyCallOldFrameSink(u8 first, u8 second, u8 far_value, u8 after_far) {

  g_allocator_call_old_frame_sink = first ^ second ^ far_value ^ after_far;
}

void allocatorRaPolicyCallOldFrameAddress(u8 first, u8 second, u8 far_source, u8 after_far) {

  u8 padding[119];
  u8 far_value;

  padding[0] = 1;
  far_value = far_source + padding[0];

  __asm(".DB \"01>\"");
  allocatorRaPolicyCallOldFrameSink(first, second, far_value, after_far);
  __asm(".DB \"<01\"");
}

void allocatorRaPolicyCallOldFrameSpills(u8 first, u8 second, u8 third, u8 fourth) {

  __asm(".DB \"02>\"");
  allocatorRaPolicyCallOldFrameSink(first + 1, second + 2, third + 3, fourth + 4);
  __asm(".DB \"<02\"");
}

void main(void) {
}
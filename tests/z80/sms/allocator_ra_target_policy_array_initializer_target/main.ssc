u8 g_allocator_array_initializer_byte_sink;
u16 g_allocator_array_initializer_word_sink;

void allocatorRaPolicyArrayInitializerNearByte(u8 seed) {

  u8 values[6] = { 1, 2, seed, 4, 5, 6 };

  __asm(".DB \"01>\"");
  g_allocator_array_initializer_byte_sink = values[2] ^ values[5];
  __asm(".DB \"<01\"");
}

void allocatorRaPolicyArrayInitializerNearWord(u16 seed) {

  u16 values[6] = { 0x0102, 0x0304, seed, 0x0506, 0x0708, 0x090a };

  __asm(".DB \"02>\"");
  g_allocator_array_initializer_word_sink = values[2] ^ values[5];
  __asm(".DB \"<02\"");
}

void allocatorRaPolicyArrayInitializerFarByte(u8 seed) {

  u8 padding[140];
  u8 values[6] = { 7, 8, seed, 10, 11, 12 };

  padding[139] = seed;
  __asm(".DB \"03>\"");
  g_allocator_array_initializer_byte_sink = values[2] ^ values[5] ^ padding[139];
  __asm(".DB \"<03\"");
}

void allocatorRaPolicyArrayInitializerFarWord(u16 seed) {

  u8 padding[140];
  u16 values[6] = { 0x1112, 0x1314, seed, 0x1516, 0x1718, 0x191a };

  padding[139] = seed;
  __asm(".DB \"04>\"");
  g_allocator_array_initializer_word_sink = values[2] ^ values[5] ^ padding[139];
  __asm(".DB \"<04\"");
}


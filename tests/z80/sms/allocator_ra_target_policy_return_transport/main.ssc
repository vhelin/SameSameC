u8 g_allocator_policy_call_byte_sink;
u16 g_allocator_policy_call_word_sink;

u8 allocatorRaPolicyCallByteCallee(u8 value) {
  return value + 3;
}

u16 allocatorRaPolicyCallWordCallee(u16 value) {
  return value + 0x0103;
}

u8 allocatorRaPolicyCallByte(u8 value, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = allocatorRaPolicyCallByteCallee(value) ^ mask;
  g_allocator_policy_call_byte_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaPolicyCallWord(u16 value, u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = allocatorRaPolicyCallWordCallee(value) ^ mask;
  g_allocator_policy_call_word_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

u8 allocatorRaPolicyCallAlternate(u8 value, u8 left, u8 right) {

  u8 out;

  __asm(".DB \"03>\"");
  out = allocatorRaPolicyCallByteCallee(value) ^ (left + right);
  g_allocator_policy_call_byte_sink = out;
  __asm(".DB \"<03\"");

  return out;
}

void main(void) {
}
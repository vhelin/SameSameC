u8 g_call_source = 0x33;

void allocatorRaCallArgumentsSinkA(u8 constant_value, u8 stack_value, u8 global_value, u8 temp_value) {
}

void allocatorRaCallArgumentsA(u8 a, u8 b) {

  __asm(".DB \"01>\"");
  allocatorRaCallArgumentsSinkA(0x12, a, g_call_source, a + b);
  __asm(".DB \"<01\"");
}


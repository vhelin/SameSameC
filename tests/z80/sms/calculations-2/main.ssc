void convertNumbersToChars16(u16 value, u8 *chars, u8 *index) {

  u8 j = index[0];
  u8 v;

  v = (value >> 12) & 0xF;
  if (v < 10)
    v += 0x10;
  else
    v += 0x17;
  chars[j++] = v;
  chars[j++] = 0x00;

  v = (value >> 8) & 0xF;
  if (v < 10)
    v += 0x10;
  else
    v += 0x17;
  chars[j++] = v;
  chars[j++] = 0x00;

  v = (value >> 4) & 0xF;
  if (v < 10)
    v += 0x10;
  else
    v += 0x17;
  chars[j++] = v;
  chars[j++] = 0x00;

  v = value & 0xF;
  if (v < 10)
    v += 0x10;
  else
    v += 0x17;
  chars[j++] = v;
  chars[j++] = 0x00;

  index[0] = j;
}

static const u8 g_numberToCharacterLUT[] = {
  0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, // 0-9
  0x21, 0x22, 0x23, 0x24, 0x25, 0x26                          // A-F
};

void convertNumbersToChars16QUICK(u16 value, u8 **chars) {

  u8 *ptr = chars[0];
  u8 v;

  v = g_numberToCharacterLUT[value & 0xF];
  ptr[6] = v;
  ptr[7] = 0x00;

  value >>= 4;
  v = g_numberToCharacterLUT[value & 0xF];
  ptr[4] = v;
  ptr[5] = 0x00;

  value >>= 4;
  v = g_numberToCharacterLUT[value & 0xF];
  ptr[2] = v;
  ptr[3] = 0x00;

  value >>= 4;
  v = g_numberToCharacterLUT[value & 0xF];
  ptr[0] = v;
  ptr[1] = 0x00;

  chars[0] = ptr + 8;
}


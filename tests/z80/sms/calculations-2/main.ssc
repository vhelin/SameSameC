
// assets/data/asm code taken from https://www.smspower.org/maxim/HowToProgram/Lesson1AllOnOnePage (helloworld.zip)

// Exercise arithmetic, arrays, records, RAM management and game-style workloads.
// Each displayed row compares an expected result with three calculated results.

// ROM header
__asm(".sdsctag 1.0, \"TEST\", \"Calculations 2\", \"Ville Helin\"");


const u8 g_calculationGameGear = 0;
#include "../../common/calculation_display.ssc"
#include "../../common/calculation_arithmetic_2.ssc"

void main(void) {

  init();
  calculateAndPrintTrampoline();

  // turn screen on
  __z80_out[0xBF] = 0b11000000;
            //         |||| |`- Zoomed sprites -> 16x16 pixels
            //         |||| `-- Doubled sprites -> 2 tiles per sprite, 8x16
            //         |||`---- 30 row/240 line mode
            //         ||`----- 28 row/224 line mode
            //         |`------ VBlank interrupts
            //         `------- Enable display
  __z80_out[0xBF] = 0x81;

  // main loop
  while (1)
    ;
}


static void calculateAndPrintTrampoline(void) {

  u8 one = 1;

  calculateAndPrintComplex(one);
}

static void calculateAndPrintComplex(u8 one) {

  u8 i;

  //////////////////////////////////////////////////////////////////////////////////////////
  // Hello world!
  //////////////////////////////////////////////////////////////////////////////////////////

  const u16 testMessage[] = { 0x28,0x45,0x4c,0x4c,0x4f,0x00,0x37,0x4f,0x52,0x4c,0x44,0x01 };
  u8 *testMessagePtr = testMessage;

  // test string
  __z80_out[0xBF] = 0x00;
  __z80_out[0xBF] = 0x40 | 0x38;
  for (i = 0; i < sizeof(testMessage); i++)
    __z80_out[0xBE] = testMessagePtr[i];

  u8 chars[80];
  u16 extra1;
  u16 extra2;
  u16 extra3;
  u8 zero = 1 - one;

  extra1 = ((((0x16D5 ^ 0x05A3) + 0x0127) - (0x0127 + zero)) ^ 0x05A3) + one - one;
  extra2 = calculationProductRestore(extra1, 3, 2);
  extra3 = calculationPartitionRestore(extra2, 17, 0x73C1);
  printCalculationLine(chars, 0x40, 0x78, 0x16D5, extra1, extra2, extra3);

  extra1 = (((((0x2A7B + 0x0249) ^ 0x1E36) ^ 0x1E36) - 0x0249) | zero) + one - one;
  extra2 = calculationShiftRestore(extra1, one, 0x4B2D);
  extra3 = calculationProductRestore(extra2, 2, 1);
  printCalculationLine(chars, 0x80, 0x78, 0x2A7B, extra1, extra2, extra3);

  extra1 = (((((0x31C6 * (one + one)) + one) / (one + one)) ^ 0x2F19) ^ 0x2F19) + zero;
  extra2 = calculationPartitionRestore(extra1, 19, 0x65D2);
  extra3 = calculationShiftRestore(extra2, one, 0x194E);
  printCalculationLine(chars, 0xC0, 0x78, 0x31C6, extra1, extra2, extra3);

  extra1 = ((((0x0D9E ^ 0x3A6C) + 0x04B5) - (0x04B5 + zero)) ^ 0x3A6C) + one - one;
  extra2 = calculationProductRestore(extra1, 5, 3);
  extra3 = calculationPartitionRestore(extra2, 23, 0x57A1);
  printCalculationLine(chars, 0x40, 0x79, 0x0D9E, extra1, extra2, extra3);

  extra1 = (((((0x24B1 + 0x0337) ^ 0x6D24) ^ 0x6D24) - 0x0337) | zero) + one - one;
  extra2 = calculationShiftRestore(extra1, one, 0x0ACF);
  extra3 = calculationProductRestore(extra2, 2, 1);
  printCalculationLine(chars, 0x80, 0x79, 0x24B1, extra1, extra2, extra3);

  extra1 = (((((0x3E72 * (one + one)) + one) / (one + one)) ^ 0x172D) ^ 0x172D) + zero;
  extra2 = calculationPartitionRestore(extra1, 29, 0x48B6);
  extra3 = calculationShiftRestore(extra2, one, 0x21E3);
  printCalculationLine(chars, 0xC0, 0x79, 0x3E72, extra1, extra2, extra3);

  extra1 = ((((0x19AF ^ 0x7248) + 0x0583) - (0x0583 + zero)) ^ 0x7248) + one - one;
  extra2 = calculationProductRestore(extra1, 3, 2);
  extra3 = calculationPartitionRestore(extra2, 31, 0x36D9);
  printCalculationLine(chars, 0x40, 0x7A, 0x19AF, extra1, extra2, extra3);

  extra1 = (((((0x2D34 + 0x016D) ^ 0x43B7) ^ 0x43B7) - 0x016D) | zero) + one - one;
  extra2 = calculationShiftRestore(extra1, one, 0x5C12);
  extra3 = calculationProductRestore(extra2, 2, 1);
  printCalculationLine(chars, 0x80, 0x7A, 0x2D34, extra1, extra2, extra3);

  extra1 = calculationArrayWorkload(0x47C1, 16, chars);
  extra2 = calculationShiftRestore(extra1, one, 0x0D96);
  extra3 = calculationProductRestore(extra2, 3, 2);
  printCalculationLine(chars, 0xC0, 0x7A, 0x1FE6, extra1, extra2, extra3);

  u8 *reg = 0xffff;

  reg[0] = 2;
  calculateAndPrintComplexBank2(chars, one, zero);

  reg[0] = 3;
  calculateAndPrintComplexBank3(chars, one, zero);

  reg[0] = 1;
  calculateAndPrintComplexBank1(chars, one, zero);
}

void calculateAndPrintComplexBank1(u8 *chars, u8 one, u8 zero);
void calculateAndPrintComplexBank2(u8 *chars, u8 one, u8 zero);
void calculateAndPrintComplexBank3(u8 *chars, u8 one, u8 zero);

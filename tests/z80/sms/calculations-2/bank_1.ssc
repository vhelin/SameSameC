
void printCalculationLine(u8 *chars, u8 addressLow, u8 addressHigh, u16 expected, u16 first, u16 second, u16 third);
u16 calculationProductRestore(u16 value, u16 multiplier, u16 remainder);
u16 calculationShiftRestore(u16 value, u16 shift, u16 mask);
u16 calculationPartitionRestore(u16 value, u16 divisor, u16 mask);

void calculateAndPrintComplexBank1(u8 *chars, u8 one, u8 zero) {

  u16 extra1;
  u16 extra2;
  u16 extra3;

  extra1 = calculationHeapWorkload(0x4219, 16, chars);
  extra2 = calculationPartitionRestore(extra1, 61, 0x5AA5);
  extra3 = calculationProductRestore(extra2, 3, 2);
  printCalculationLine(chars, 0x40, 0x7D, 0x0DB1, extra1, extra2, extra3);

  extra1 = (((((0x43BE + 0x0625) ^ 0x1B6D) ^ 0x1B6D) - 0x0625) | zero) + one - one;
  extra2 = calculationShiftRestore(extra1, one, 0x739C);
  extra3 = calculationPartitionRestore(extra2, 67, 0x2662);
  printCalculationLine(chars, 0x80, 0x7D, 0x43BE, extra1, extra2, extra3);

  extra1 = (((((0x2E91 * (one + 2)) + 2) / (one + 2)) ^ 0x4D2A) ^ 0x4D2A) + zero;
  extra2 = calculationProductRestore(extra1, 5, 3);
  extra3 = calculationShiftRestore(extra2, one, 0x18E7);
  printCalculationLine(chars, 0xC0, 0x7D, 0x2E91, extra1, extra2, extra3);

  extra1 = ((((0x145C ^ 0x63A9) + 0x027B) - (0x027B + zero)) ^ 0x63A9) + one - one;
  extra2 = calculationProductRestore(extra1, 2, 1);
  extra3 = calculationPartitionRestore(extra2, 71, 0x39E4);
  printCalculationLine(chars, 0x00, 0x79, 0x145C, extra1, extra2, extra3);

  extra1 = (((((0x286F + 0x051D) ^ 0x74B2) ^ 0x74B2) - 0x051D) | zero) + one - one;
  extra2 = calculationShiftRestore(extra1, one, 0x1D73);
  extra3 = calculationProductRestore(extra2, 2, 1);
  printCalculationLine(chars, 0x00, 0x7A, 0x286F, extra1, extra2, extra3);

  extra1 = (((((0x3295 * (one + one)) + one) / (one + one)) ^ 0x4A6D) ^ 0x4A6D) + zero;
  extra2 = calculationPartitionRestore(extra1, 73, 0x25C8);
  extra3 = calculationShiftRestore(extra2, one, 0x6E31);
  printCalculationLine(chars, 0x00, 0x7B, 0x3295, extra1, extra2, extra3);

  extra1 = ((((0x1BC7 ^ 0x52F4) + 0x0689) - (0x0689 + zero)) ^ 0x52F4) + one - one;
  extra2 = calculationProductRestore(extra1, 3, 2);
  extra3 = calculationPartitionRestore(extra2, 79, 0x47A5);
  printCalculationLine(chars, 0x00, 0x7C, 0x1BC7, extra1, extra2, extra3);

  extra1 = calculationSortWorkload(0x253A, 16, chars);
  extra2 = calculationProductRestore(extra1, 3, 2);
  extra3 = calculationPartitionRestore(extra2, 79, 0x47A5);
  printCalculationLine(chars, 0x00, 0x7D, 0x09AD, extra1, extra2, extra3);
}

u16 calculationSortWorkload(u16 seed, u16 count, u8 *bytes) {

  u16 values[16];
  u8 heap[64];
  u8 *histogram;
  u16 handle;
  u16 i;
  u16 j;
  u16 value;
  u16 checksum = seed & 0x1FFF;

  heap[0] = 64;
  handle = gameRamAllocate(heap, 8);
  if (handle == 0)
    return 0xFFFF;
  histogram = &heap[handle];
  for (i = 0; i < 8; i++)
    histogram[i] = 0;
  for (i = 0; i < count; i++) {
    values[i] = ((seed ^ (i * 131)) + count * 19) & 0x1FFF;
    j = (values[i] >> 3) & 7;
    histogram[j] = histogram[j] + 1;
  }

  for (i = 1; i < count; i++) {
    value = values[i];
    j = i;
    while (j > 0) {
      if (values[j - 1] <= value)
        break;
      values[j] = values[j - 1];
      j--;
    }
    values[j] = calculationPartitionRestore(value, 31, seed);
  }

  for (i = 0; i < count; i++) {
    bytes[i * 2] = values[i];
    bytes[i * 2 + 1] = values[i] >> 8;
    checksum = (checksum + values[i] * (i + 1)) & 0x1FFF;
  }
  for (i = 0; i < 8; i++) {
    bytes[32 + i] = histogram[i];
    checksum = (checksum + histogram[i] * (i + 1)) & 0x1FFF;
  }
  bytes[40] = gameRamRelease(heap, handle);
  bytes[41] = heap[0];
  if (bytes[40] != 1)
    return 0xFFFF;
  if (bytes[41] != 64)
    return 0xFFFF;
  return (checksum + bytes[40] * 9 + bytes[41] * 10) & 0x1FFF;
}

// A 64-byte arena uses one-byte headers: total block size, with bit 7 for in-use.
// Handles are payload offsets; zero means allocation/free failure.
u16 gameRamAllocate(u8 *heap, u16 requested) {

  u16 offset = 0;
  u16 length;
  u16 used;

  if (requested == 0)
    return 0;
  if (requested > 63)
    return 0;
  while (offset < 64) {
    length = heap[offset] & 0x7F;
    if (heap[offset] < 128) {
      if (length >= requested + 1) {
        used = requested + 1;
        if (length - used > 1)
          heap[offset + used] = length - used;
        else
          used = length;
        heap[offset] = used | 0x80;
        return offset + 1;
      }
    }
    offset += length;
  }
  return 0;
}

u16 gameRamRelease(u8 *heap, u16 handle) {

  u16 offset = 0;
  u16 length;
  u16 next;
  u16 found = 0;

  while (offset < 64) {
    length = heap[offset] & 0x7F;
    if (offset + 1 == handle) {
      if (heap[offset] < 128)
        return 0;
      heap[offset] = length;
      found = 1;
      break;
    }
    offset += length;
  }
  if (found == 0)
    return 0;
  offset = 0;
  while (offset < 64) {
    length = heap[offset] & 0x7F;
    next = offset + length;
    if (heap[offset] < 128) {
      if (next < 64) {
        if (heap[next] < 128) {
          heap[offset] = length + heap[next];
          continue;
        }
      }
    }
    offset += length;
  }
  return 1;
}

u16 calculationHeapWorkload(u16 seed, u16 count, u8 *bytes) {

  u16 handles[8];
  u16 sizes[8];
  u16 i;
  u16 j;
  u16 round;
  u16 slot;
  u16 handle;
  u16 checksum = seed & 0x1FFF;

  for (i = 0; i < 64; i++)
    bytes[i] = seed + i * 13;
  for (i = 64; i < 71; i++)
    bytes[i] = 0;
  bytes[0] = 64;

  handle = gameRamAllocate(bytes, 63);
  checksum += handle;
  if (handle != 0) {
    bytes[handle] = seed;
    bytes[handle + 62] = seed >> 8;
  }
  checksum += gameRamAllocate(bytes, 1) * 3;
  checksum += gameRamRelease(bytes, handle) * 5;
  checksum += gameRamRelease(bytes, handle) * 7;
  checksum += gameRamAllocate(bytes, 0) * 11;
  checksum += gameRamAllocate(bytes, 64) * 13;
  checksum += gameRamRelease(bytes, 2) * 17;
  handles[0] = gameRamAllocate(bytes, 7);
  handles[1] = gameRamAllocate(bytes, 7);
  handles[2] = gameRamAllocate(bytes, 7);
  checksum += handles[0] + handles[1] + handles[2];
  checksum += gameRamRelease(bytes, handles[0]) * 19;
  checksum += gameRamRelease(bytes, handles[2]) * 23;
  handle = gameRamAllocate(bytes, 15);
  checksum += handle * 29;
  checksum += gameRamRelease(bytes, handles[1]) * 31;
  checksum += gameRamRelease(bytes, handle) * 37;

  for (i = 0; i < 8; i++) {
    handles[i] = 0;
    sizes[i] = 0;
  }
  for (round = 0; round < count; round++) {
    slot = round & 7;
    if (handles[slot] != 0) {
      bytes[66] = bytes[66] + gameRamRelease(bytes, handles[slot]);
      handles[slot] = 0;
    }
    sizes[slot] = 2 + (((seed >> (round & 7)) + round * 3) & 15);
    handle = gameRamAllocate(bytes, sizes[slot]);
    handles[slot] = handle;
    if (handle == 0)
      bytes[65] = bytes[65] + 1;
    else {
      bytes[64] = bytes[64] + 1;
      for (j = 0; j < sizes[slot]; j++)
        bytes[handle + j] = seed + round * 7 + j;
    }
    for (i = 0; i < 8; i++) {
      if (handles[i] != 0)
        checksum = (checksum + bytes[handles[i]] * (i + 1) + bytes[handles[i] + sizes[i] - 1]) & 0x1FFF;
    }
    if ((round & 1) != 0) {
      slot = (slot + 3) & 7;
      if (handles[slot] != 0) {
        bytes[66] = bytes[66] + gameRamRelease(bytes, handles[slot]);
        handles[slot] = 0;
      }
    }
  }
  for (i = 0; i < 8; i++) {
    if (handles[i] != 0)
      bytes[66] = bytes[66] + gameRamRelease(bytes, handles[i]);
  }
  bytes[67] = gameRamRelease(bytes, 0);
  handle = gameRamAllocate(bytes, 63);
  bytes[68] = handle;
  bytes[69] = gameRamRelease(bytes, handle);
  bytes[70] = bytes[0];
  for (i = 0; i < 71; i++)
    checksum = (checksum + bytes[i] * (i + 1)) & 0x1FFF;
  return checksum;
}

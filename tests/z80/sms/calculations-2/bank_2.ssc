void printCalculationLine(u8 *chars, u8 addressLow, u8 addressHigh, u16 expected, u16 first, u16 second, u16 third);
u16 calculationProductRestore(u16 value, u16 multiplier, u16 remainder);
u16 calculationShiftRestore(u16 value, u16 shift, u16 mask);
u16 calculationPartitionRestore(u16 value, u16 divisor, u16 mask);

struct GameActor {
  u16 x;
  u16 y;
  u16 score;
  u8 direction;
  u8 health;
};

void calculateAndPrintComplexBank2(u8 *chars, u8 one, u8 zero) {

  u16 extra1;
  u16 extra2;
  u16 extra3;

  extra1 = calculationActorWorkload(0x2D57, 16, chars);
  extra2 = calculationProductRestore(extra1, 2, 1);
  extra3 = calculationPartitionRestore(extra2, 43, 0x6C39);
  printCalculationLine(chars, 0x40, 0x7B, 0x0B42, extra1, extra2, extra3);

  extra1 = (((((0x13ED + 0x0731) ^ 0x2D4B) ^ 0x2D4B) - 0x0731) | zero) + one - one;
  extra2 = calculationShiftRestore(extra1, one, 0x369C);
  extra3 = calculationProductRestore(extra2, 5, 3);
  printCalculationLine(chars, 0x80, 0x7B, 0x13ED, extra1, extra2, extra3);

  extra1 = calculationStencilWorkload(0x36B9, 16, chars);
  extra2 = calculationShiftRestore(extra1, one, 0x2492);
  extra3 = calculationPartitionRestore(extra2, 47, 0x4E71);
  printCalculationLine(chars, 0xC0, 0x7B, 0x1334, extra1, extra2, extra3);
}

u16 calculationStencilWorkload(u16 seed, u16 count, u8 *bytes) {

  u16 grid[16];
  u16 next[16];
  u16 row;
  u16 column;
  u16 i;
  u16 pass;
  u16 sum;
  u16 neighbour;
  u16 checksum = seed & 0x1FFF;

  for (i = 0; i < count; i++)
    grid[i] = (seed + i * i + i * 17) & 0x1FFF;
  for (pass = 0; pass < 3; pass++) {
    for (row = 0; row < 4; row++) {
      for (column = 0; column < 4; column++) {
        i = row * 4 + column;
        if (i >= count)
          continue;
        sum = grid[i] * 2;
        if (column > 0)
          sum += grid[i - 1];
        else
          sum += grid[i];
        neighbour = i;
        if (column < 3) {
          if (i + 1 < count)
            neighbour = i + 1;
        }
        sum += grid[neighbour];
        if (row > 0)
          sum += grid[i - 4];
        else
          sum += grid[i];
        if (i + 4 < count)
          sum += grid[i + 4];
        else
          sum += grid[i];
        next[i] = ((sum / 6) + ((seed >> pass) & 31)) & 0x1FFF;
      }
    }
    for (i = 0; i < count; i++)
      grid[i] = calculationShiftRestore(next[i], 1, seed);
  }

  for (i = 0; i < count; i++) {
    bytes[i * 2] = grid[i];
    bytes[i * 2 + 1] = grid[i] >> 8;
    checksum = (checksum + calculationPartitionRestore(grid[i], 29, seed)) & 0x1FFF;
  }
  return checksum;
}

u16 calculationActorWorkload(u16 seed, u16 count, u8 *bytes) {

  struct GameActor actors[16];
  u8 tiles[64];
  u16 i;
  u16 frame;
  u16 x;
  u16 y;
  u16 speed;
  u16 tile;
  u8 direction;
  u8 health;
  u16 checksum = seed & 0x1FFF;

  for (i = 0; i < 64; i++)
    tiles[i] = (seed + i * 5 + (i / 8) * 3) & 7;
  for (i = 0; i < count; i++) {
    actors[i].x = (seed + i * 13) & 127;
    actors[i].y = ((seed >> 3) + i * 19) & 127;
    actors[i].score = 0;
    actors[i].direction = (seed >> i) & 3;
    actors[i].health = 3 + (i & 3);
  }
  for (frame = 0; frame < 6; frame++) {
    for (i = 0; i < count; i++) {
      if (actors[i].health == 0)
        continue;
      x = actors[i].x;
      y = actors[i].y;
      speed = 1 + (i & 3);
      direction = (actors[i].direction + frame) & 3;
      switch (direction) {
      case 0: x = (x + speed) & 127; break;
      case 1: x = (x + 128 - speed) & 127; break;
      case 2: y = (y + speed) & 127; break;
      default: y = (y + 128 - speed) & 127; break;
      }
      tile = (y / 16) * 8 + x / 16;
      if ((tiles[tile] & 1) != 0)
        actors[i].direction = (direction + 1) & 3;
      else {
        actors[i].x = x;
        actors[i].y = y;
      }
      tile = (actors[i].y / 16) * 8 + actors[i].x / 16;
      if ((tiles[tile] & 2) != 0)
        actors[i].health = actors[i].health - 1;
      if ((tiles[tile] & 4) != 0) {
        actors[i].score = actors[i].score + calculationPartitionRestore((i + 1) * 4, 7, seed);
        tiles[tile] = tiles[tile] & 3;
      }
    }
  }
  for (i = 0; i < count; i++) {
    health = actors[i].health;
    direction = actors[i].direction;
    bytes[i * 4] = actors[i].x;
    bytes[i * 4 + 1] = actors[i].y;
    bytes[i * 4 + 2] = health;
    bytes[i * 4 + 3] = actors[i].score;
    bytes[64 + i] = direction;
    checksum = (checksum + actors[i].x * 3 + actors[i].y * 5 + actors[i].score + health * 17 + direction) & 0x1FFF;
  }
  for (i = 0; i < 64; i++)
    checksum = (checksum + tiles[i] * (i + 1)) & 0x1FFF;
  return checksum;
}

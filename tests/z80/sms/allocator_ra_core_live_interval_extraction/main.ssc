struct AllocatorRaCoreIntervalValue {
  u8 pad;
  u8 byte_value;
  u16 word_value;
};

struct AllocatorRaCoreIntervalValue g_allocator_core_interval_values[8];
u8 g_allocator_core_interval_sink;

u8 allocatorRaCoreIntervalArrayWrite(u8 index_left, u8 index_right, u8 value_left, u8 value_right) {

  __asm(".DB \"01>\"");
  g_allocator_core_interval_values[index_left + index_right].byte_value = value_left + value_right;
  __asm(".DB \"<01\"");

  return value_left;
}

u8 allocatorRaCoreIntervalReused(u8 left, u8 right, u8 third, u8 fourth) {

  __asm(".DB \"02>\"");
  g_allocator_core_interval_sink = (left + right) + third;
  g_allocator_core_interval_sink = (third + fourth) + left;
  __asm(".DB \"<02\"");

  return g_allocator_core_interval_sink;
}

void main(void) {
}

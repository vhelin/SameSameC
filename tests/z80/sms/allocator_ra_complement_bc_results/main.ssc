u8 g_allocator_complement_bc_target;

u8 allocatorRaComplementResultC(u8 value, u8 left, u8 right) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (~value) ^ (left + right);
  g_allocator_complement_bc_target = out;
  __asm(".DB \"<01\"");

  return out;
}

u8 allocatorRaComplementResultB(u8 a, u8 b, u8 value, u8 left, u8 right) {

  u8 out;

  __asm(".DB \"02>\"");
  out = (a + b) ^ ((~value) ^ (left + right));
  g_allocator_complement_bc_target = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}
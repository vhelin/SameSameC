u8 g_allocator_shift_sink_a;
u16 g_allocator_shift_sink_hl;

u8 allocatorRaShiftResultA(u8 value, u8 count, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (value << count) ^ mask;
  g_allocator_shift_sink_a = out;
  __asm(".DB \"<01\"");

  return out;
}

u8 allocatorRaShiftArg1A(u8 value, u8 bias, u8 count) {

  u8 out;

  __asm(".DB \"02>\"");
  out = (value + bias) << count;
  g_allocator_shift_sink_a = out;
  __asm(".DB \"<02\"");

  return out;
}

u16 allocatorRaShiftResultHl(u16 value, u16 count, u16 mask) {

  u16 out;

  __asm(".DB \"03>\"");
  out = (value << count) ^ mask;
  g_allocator_shift_sink_hl = out;
  __asm(".DB \"<03\"");

  return out;
}

u16 allocatorRaShiftArg1Hl(u16 value, u16 bias, u16 count) {

  u16 out;

  __asm(".DB \"04>\"");
  out = (value + bias) << count;
  g_allocator_shift_sink_hl = out;
  __asm(".DB \"<04\"");

  return out;
}


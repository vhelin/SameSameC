u8 allocatorRaCoreActiveSlotByte(u8 a, u8 b, u8 c) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (a + b) + ((c + 1) + c);
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaCoreActiveSlotWord(u16 a, u16 b, u16 c) {

  u16 out;

  __asm(".DB \"02>\"");
  out = (a + b) + ((c + 1) + c);
  __asm(".DB \"<02\"");

  return out;
}


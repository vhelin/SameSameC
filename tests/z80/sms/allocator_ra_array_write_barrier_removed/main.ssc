u8 g_allocator_array_write_barrier_removed_a[256];

u8 allocatorRaArrayWriteBarrierRemovedA(u8 left, u8 right, u8 value) {

  u8 after;

  __asm(".DB \"01>\"");
  g_allocator_array_write_barrier_removed_a[left + right] = value;
  after = (left + right) ^ value;
  __asm(".DB \"<01\"");

  return after;
}

void main(void) {
}

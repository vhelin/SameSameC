u8 g_allocator_specialized_address_values[256];
u16 g_allocator_specialized_address_index;
u16 g_allocator_specialized_address_operand;
u16 g_allocator_specialized_address_sink;

u16 allocatorRaPolicySpecializedGetLocal(u16 index, u16 mask) {

  u16 out;

  __asm(".DB \"01>\"");
  out = (&g_allocator_specialized_address_values[index]) ^ mask;
  g_allocator_specialized_address_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaPolicySpecializedGetGlobal(u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = (&g_allocator_specialized_address_values[g_allocator_specialized_address_index]) ^ mask;
  g_allocator_specialized_address_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

u16 allocatorRaPolicySpecializedMulLocal(u16 left, u16 right, u16 mask) {

  u16 out;

  __asm(".DB \"03>\"");
  out = (left * right) ^ mask;
  g_allocator_specialized_address_sink = out;
  __asm(".DB \"<03\"");

  return out;
}

u16 allocatorRaPolicySpecializedDivGlobal(u16 left, u16 mask) {

  u16 out;

  __asm(".DB \"04>\"");
  out = (left / g_allocator_specialized_address_operand) ^ mask;
  g_allocator_specialized_address_sink = out;
  __asm(".DB \"<04\"");

  return out;
}

u16 allocatorRaPolicySpecializedModFar(u16 left, u16 right, u16 mask) {

  u8 padding[140];
  u16 far_right;
  u16 out;

  __asm(".DB \"05>\"");
  padding[0] = 1;
  far_right = right + padding[0];
  out = (left % far_right) ^ mask;
  g_allocator_specialized_address_sink = out;
  __asm(".DB \"<05\"");

  return out;
}

void main(void) {
}
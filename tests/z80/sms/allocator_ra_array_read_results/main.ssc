u8 g_allocator_array_read_values_a[16];
u16 g_allocator_array_read_values_hl[16];
u8 g_allocator_array_read_sink_a;
u16 g_allocator_array_read_sink_hl;

u8 allocatorRaArrayReadResultA(u8 index, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = g_allocator_array_read_values_a[index] ^ mask;
  g_allocator_array_read_sink_a = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaArrayReadResultHl(u8 index, u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = g_allocator_array_read_values_hl[index] ^ mask;
  g_allocator_array_read_sink_hl = out;
  __asm(".DB \"<02\"");

  return out;
}

u8 allocatorRaZ80InReadResultA(u8 port, u8 mask) {

  u8 out;

  __asm(".DB \"03>\"");
  out = __z80_in[port] ^ mask;
  g_allocator_array_read_sink_a = out;
  __asm(".DB \"<03\"");

  return out;
}


u8 g_allocator_complement_source_byte;
u8 g_allocator_complement_target_byte;
u16 g_allocator_complement_source_word;
u16 g_allocator_complement_target_word;
u8 *g_allocator_complement_padding;

void allocatorRaPolicyComplementGlobalByte(void) {

  __asm(".DB \"01>\"");
  g_allocator_complement_target_byte = ~g_allocator_complement_source_byte;
  __asm(".DB \"<01\"");
}

void allocatorRaPolicyComplementNearByte(u8 source) {

  u8 result;

  __asm(".DB \"02>\"");
  result = ~source;
  __asm(".DB \"<02\"");
  g_allocator_complement_target_byte = result;
}

void allocatorRaPolicyComplementFarByte(u8 left, u8 right) {

  u8 padding[140];
  u8 source;
  u8 result;

  source = left + right;
  g_allocator_complement_padding = &padding[139];
  __asm("NOP");
  __asm(".DB \"03>\"");
  result = ~source;
  __asm(".DB \"<03\"");
  g_allocator_complement_target_byte = result;
}

void allocatorRaPolicyComplementRetainedResultByte(u8 source, u8 other) {

  __asm(".DB \"04>\"");
  g_allocator_complement_target_byte = (~source) ^ other;
  __asm(".DB \"<04\"");
}

void allocatorRaPolicyComplementGlobalWord(void) {

  __asm(".DB \"05>\"");
  g_allocator_complement_target_word = ~g_allocator_complement_source_word;
  __asm(".DB \"<05\"");
}

void allocatorRaPolicyComplementNearWord(u16 source) {

  u16 result;

  __asm(".DB \"06>\"");
  result = ~source;
  __asm(".DB \"<06\"");
  g_allocator_complement_target_word = result;
}

void allocatorRaPolicyComplementFarWord(u16 left, u16 right) {

  u8 padding[140];
  u16 source;
  u16 result;

  source = left ^ right;
  g_allocator_complement_padding = &padding[139];
  __asm("NOP");
  __asm(".DB \"07>\"");
  result = ~source;
  __asm(".DB \"<07\"");
  g_allocator_complement_target_word = result;
}

void allocatorRaPolicyComplementRetainedResultWord(u16 source, u16 other) {

  __asm(".DB \"08>\"");
  g_allocator_complement_target_word = (~source) ^ other;
  __asm(".DB \"<08\"");
}

void main(void) {
}
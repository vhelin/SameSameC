u16 g_return_source_hl = 0x1234;
u8 g_return_guard_hl = 1;

u16 allocatorRaReturnLocationsHlConst(void) {

  if (g_return_guard_hl) {
    __asm(".DB \"01>\"");
    return 0x4567;
  }
  __asm(".DB \"<01\"");

  return 0;
}

u16 allocatorRaReturnLocationsHlStack(u16 a) {

  if (a) {
    __asm(".DB \"02>\"");
    return a;
  }
  __asm(".DB \"<02\"");

  return 0;
}

u16 allocatorRaReturnLocationsHlGlobal(void) {

  if (g_return_guard_hl) {
    __asm(".DB \"03>\"");
    return g_return_source_hl;
  }
  __asm(".DB \"<03\"");

  return 0;
}

u16 allocatorRaReturnLocationsHlTemp(u16 a, u16 b) {

  if (a) {
    __asm(".DB \"04>\"");
    return a + b;
  }
  __asm(".DB \"<04\"");

  return 0;
}

s16 allocatorRaReturnLocationsHlSignedExtend(s8 a) {

  if (a) {
    __asm(".DB \"05>\"");
    return a;
  }
  __asm(".DB \"<05\"");

  return 0;
}


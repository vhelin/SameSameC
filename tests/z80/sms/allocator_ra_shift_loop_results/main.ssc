u8 g_allocator_shift_loop_sink;

u8 allocatorRaShiftLeftLoop(u8 count, u8 value) {

  __asm(".DB \"01>\"");
  value = value + 0;
  while (count + value) {
    value = value << 1;
    count = count - 1;
  }
  g_allocator_shift_loop_sink = value;
  __asm(".DB \"<01\"");

  return g_allocator_shift_loop_sink;
}

u8 allocatorRaShiftRightLoop(u8 count, u8 value) {

  __asm(".DB \"02>\"");
  value = value + 0;
  while (count + value) {
    value = value >> 1;
    count = count - 1;
  }
  g_allocator_shift_loop_sink = value;
  __asm(".DB \"<02\"");

  return g_allocator_shift_loop_sink;
}

u8 allocatorRaArithmeticLoop(u8 count, u8 value, u8 step) {

  __asm(".DB \"03>\"");
  value = value + 0;
  while (count + value) {
    value = value + step;
    count = count - 1;
  }
  g_allocator_shift_loop_sink = value;
  __asm(".DB \"<03\"");

  return g_allocator_shift_loop_sink;
}

u8 allocatorRaComplementArithmeticLoop(u8 value, u8 step) {

  __asm(".DB \"04>\"");
  value = value + 0;
  while (~value) {
    value = value - step;
  }
  g_allocator_shift_loop_sink = value;
  __asm(".DB \"<04\"");

  return g_allocator_shift_loop_sink;
}

u8 allocatorRaComplementProducedLoop(u8 count, u8 value) {

  __asm(".DB \"05>\"");
  value = value + 0;
  while (count + value) {
    value = ~value;
    count = count - 1;
  }
  g_allocator_shift_loop_sink = value;
  __asm(".DB \"<05\"");

  return g_allocator_shift_loop_sink;
}

u8 allocatorRaComplementContinueLoop(u8 count, u8 value, u8 step) {

  value = value + 0;
  while (count + value) {
    count = count - 1;
    if (count & 1) {
      value = ~value;
      continue;
    }
    value = value - step;
  }

  return value + step;
}

u8 allocatorRaArithmeticLoopCompareConflict(u8 count, u8 value, u8 step) {

  value = value + 0;
  step = step + 0;
  while (count + value > step) {
    value = value + 1;
    step = step + 2;
    count = count - 1;
  }

  return value + step;
}

u8 allocatorRaShiftLoopConflict(u8 count, u8 value1, u8 value2) {

  value1 = value1 + 0;
  value2 = value2 + 0;
  while (count + value1 + value2) {
    value1 = value1 + 1;
    value2 = value2 << 1;
    count = count - 1;
  }

  return value1 + value2;
}


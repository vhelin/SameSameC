// @BT TEST-02 02 START
// @BT FD 21 FA FF FD 19 FD 7E 00 4F DD 21 00 00 DD 19
// @BT DD 7E FB 81 06 00 90 CA D9 00 69 26 00 01 01 00
// @BT 78 B1 28 07 CB 3C CB 1D 0B 18 F5 4D DD 7E FB 3D
// @BT DD 77 FB C3 AD 00 DD 21 00 C0 79 DD 77 00
// @BT END

u8 g_allocator_shift_loop_sink;

u8 allocatorRaShiftLeftLoop(u8 count, u8 value) {

  __asm(".DB \"01>\"");
  value = value + 0;
  while (count + value) {
    value = value << 1;
    count = count - 1;
  }
  g_allocator_shift_loop_sink = value;
  __asm(".DB \"<01\"");

  return g_allocator_shift_loop_sink;
}

u8 allocatorRaShiftRightLoop(u8 count, u8 value) {

  __asm(".DB \"02>\"");
  value = value + 0;
  while (count + value) {
    value = value >> 1;
    count = count - 1;
  }
  g_allocator_shift_loop_sink = value;
  __asm(".DB \"<02\"");

  return g_allocator_shift_loop_sink;
}

u8 allocatorRaShiftLoopConflict(u8 count, u8 value1, u8 value2) {

  value1 = value1 + 0;
  value2 = value2 + 0;
  while (count + value1 + value2) {
    value1 = value1 + 1;
    value2 = value2 << 1;
    count = count - 1;
  }

  return value1 + value2;
}


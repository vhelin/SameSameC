u8 g_allocator_byte_access_byte;
u16 g_allocator_byte_access_word;
s8 g_allocator_byte_access_signed;
u8 g_allocator_byte_access_unsigned;
u16 g_allocator_byte_access_narrowed;

void allocatorRaPolicyByteAccessSink(u8 byte_value, u16 word_value, s16 signed_word, u16 unsigned_word, u8 narrowed_word, u16 constant_word) {

  g_allocator_byte_access_byte = byte_value ^ narrowed_word;
  g_allocator_byte_access_word = word_value ^ signed_word ^ unsigned_word ^ constant_word;
}

void allocatorRaPolicyArgumentByteAccess(void) {

  __asm(".DB \"01>\"");
  allocatorRaPolicyByteAccessSink(g_allocator_byte_access_byte, g_allocator_byte_access_word, g_allocator_byte_access_signed, g_allocator_byte_access_unsigned, g_allocator_byte_access_narrowed, 0x6789);
  __asm(".DB \"<01\"");
}

void main(void) {
}

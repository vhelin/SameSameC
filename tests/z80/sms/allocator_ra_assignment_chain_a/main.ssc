u8 allocatorRaAssignmentChainA(u8 a, u8 b) {

  u8 c;
  u8 d;

  __asm(".DB \"01>\"");
  c = a;
  d = c;
  d = d + b;
  __asm(".DB \"<01\"");

  return d;
}


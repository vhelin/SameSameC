u8 allocatorRaAssignmentChainA(u8 a, u8 b) {

  u8 c;
  u8 d;

  __asm(".DB \"01>\"");
  c = a;
  d = c;
  d = d + b;
  __asm(".DB \"<01\"");

  return d;
}

void main(void) {
}

u8 allocatorRaScalarCopyA(u8 left_first, u8 left_second, u8 right_first, u8 right_second) {

  u8 right;
  u8 out;

  __asm(".DB \"02>\"");
  right = right_first + right_second;
  out = (left_first + left_second) + right;
  __asm(".DB \"<02\"");

  return out;
}

u8 allocatorRaScalarBit(u8 a, u8 b, u8 c) {
  u8 saved = a ^ b;
  return (c + c) + saved;
}

u16 allocatorRaScalarWord(u16 a, u16 b, u16 c) {
  u16 saved = a ^ b;
  return (c + c) + saved;
}

u16 allocatorRaScalarWordCopy(u16 a, u16 b, u16 c) {
  u16 saved = a;
  return (b + c) + saved;
}

u8 g_allocator_word_index[16];

u16 allocatorRaScalarWordIndex(u16 a, u16 b, u8 c) {
  u16 out = a + b;
  g_allocator_word_index[1] = c;
  return out + g_allocator_word_index[1];
}

u8 allocatorRaScalarBeforeCall(u8 a, u8 b, u8 c) {
  u8 called = allocatorRaAssignmentChainA(a, b);
  u8 saved = a ^ c;
  return (called + called) + saved;
}

u8 allocatorRaScalarAfterCall(u8 a, u8 b, u8 c) {
  u8 saved = a ^ b;
  u8 out = (c + c) + saved;
  allocatorRaAssignmentChainA(a, b);
  return out;
}

u8 allocatorRaScalarCallArgument(u8 a, u8 b) {
  u8 saved = a ^ b;
  return allocatorRaAssignmentChainA(saved, b);
}

u8 allocatorRaScalarAcrossCall(u8 a, u8 b, u8 c) {
  u8 saved = a ^ b;
  u8 called = allocatorRaAssignmentChainA(a, c);
  return (called + c) + saved;
}

u16 allocatorRaScalarNarrow(u16 a, u16 b, u16 c) {
  u8 saved = a + b;
  return (c + c) + saved;
}

u8 allocatorRaScalarCopyFallback(u8 first, u8 second) {

  u8 escaped;
  u8 barrier;
  u8 repeated;
  u8 redefined;
  u8 *address;
  u8 out;

  escaped = first + second;
  address = &escaped;
  out = (first + second) + escaped;
  out = out + address[0];

  barrier = first + second;
  __asm("NOP");
  out = out + barrier;

  repeated = first + second;
  out = out + repeated;
  out = out + repeated;

  redefined = first + second;
  out = out + redefined;
  redefined = first ^ second;
  out = out + redefined;

  return out;
}
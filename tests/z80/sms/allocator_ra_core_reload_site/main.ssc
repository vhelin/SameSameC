struct AllocatorRaCoreReloadValue {
  u8 byte_value;
  u16 word_value;
};

struct AllocatorRaCoreReloadValue g_allocator_core_reload_values[8];

u8 allocatorRaCoreReloadByte(u8 index_left, u8 index_right) {

  __asm(".DB \"01>\"");
  g_allocator_core_reload_values[index_left + index_right].byte_value++;
  __asm(".DB \"<01\"");

  return index_left;
}

u16 allocatorRaCoreReloadWord(u8 index_left, u8 index_right) {

  __asm(".DB \"02>\"");
  g_allocator_core_reload_values[index_left + index_right].word_value--;
  __asm(".DB \"<02\"");

  return index_right;
}

void main(void) {
}

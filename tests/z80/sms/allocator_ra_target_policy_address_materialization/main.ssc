u8 g_allocator_address_byte_sink;
u16 g_allocator_address_word_sink;

u8 allocatorRaPolicyAddressNear(u8 left, u8 right, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (left + right) ^ mask;
  g_allocator_address_byte_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

u8 allocatorRaPolicyAddressFar(u8 seed, u8 mask) {

  u8 values[140];
  u8 out;

  __asm(".DB \"02>\"");
  values[0] = seed;
  values[139] = seed + 1;
  out = values[0] ^ values[139];
  out = out ^ mask;
  g_allocator_address_byte_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

u8 allocatorRaPolicyAddressArrayByte(u8 seed, u8 mask) {

  u8 values[6] = { 1, 2, 3, 4, seed, 6 };
  u8 out;

  __asm(".DB \"03>\"");
  out = values[0] + values[4];
  out = out ^ mask;
  g_allocator_address_byte_sink = out;
  __asm(".DB \"<03\"");

  return out;
}

u16 allocatorRaPolicyAddressArrayWord(u16 seed, u16 mask) {

  u16 values[6] = { 0x0102, 0x0304, 0x0506, 0x0708, seed, 0x090a };
  u16 out;

  __asm(".DB \"04>\"");
  out = values[0] + values[4];
  out = out ^ mask;
  g_allocator_address_word_sink = out;
  __asm(".DB \"<04\"");

  return out;
}

void allocatorRaPolicyAddressSpillSink(u8 byte_value, u16 word_value) {

  g_allocator_address_byte_sink = byte_value;
  g_allocator_address_word_sink = word_value;
}

void allocatorRaPolicyAddressSpill(u8 left, u8 right, u16 word_value) {

  __asm(".DB \"05>\"");
  allocatorRaPolicyAddressSpillSink(left + right, word_value + 1);
  __asm(".DB \"<05\"");
}

void main(void) {
}
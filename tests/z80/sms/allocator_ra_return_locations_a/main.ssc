// @BT END
// @BT TEST-02 02 START
// @BT DD 6E FB DD 75 FC 21 FF FF 19 F9 C9
// @BT END
// @BT TEST-03 03 START
// @BT DD 21 00 C0 DD 6E 00 DD 21 00 00 DD 19 DD 75 FC
// @BT 21 FF FF 19 F9 C9
// @BT END
// @BT TEST-04 04 START
// @BT DD 7E FB DD 86 FA 6F DD 75 FC 21 FF FF 19 F9 C9
// @BT END

u8 g_return_source = 0x2c;
u8 g_return_guard = 1;

u8 allocatorRaReturnLocationsAConst(void) {

  if (g_return_guard) {
    __asm(".DB \"01>\"");
    return 0x5a;
  }
  __asm(".DB \"<01\"");

  return 0;
}

u8 allocatorRaReturnLocationsAStack(u8 a) {

  if (a) {
    __asm(".DB \"02>\"");
    return a;
  }
  __asm(".DB \"<02\"");

  return 0;
}

u8 allocatorRaReturnLocationsAGlobal(void) {

  if (g_return_guard) {
    __asm(".DB \"03>\"");
    return g_return_source;
  }
  __asm(".DB \"<03\"");

  return 0;
}

u8 allocatorRaReturnLocationsATemp(u8 a, u8 b) {

  if (a) {
    __asm(".DB \"04>\"");
    return a + b;
  }
  __asm(".DB \"<04\"");

  return 0;
}

void main(void) {
}
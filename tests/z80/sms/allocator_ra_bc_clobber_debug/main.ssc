u8 g_bc_clobber_add_target = 0;
u16 g_bc_clobber_complement_target = 0;
s16 g_bc_clobber_assignment_target = 0;

u8 allocatorRaBcClobberAdd8(u8 a, u8 b) {

  __asm(".DB \"01>\"");
  g_bc_clobber_add_target = a + b;
  __asm(".DB \"<01\"");

  return g_bc_clobber_add_target;
}

u16 allocatorRaBcClobberComplement16(u16 a) {

  __asm(".DB \"02>\"");
  g_bc_clobber_complement_target = ~a;
  __asm(".DB \"<02\"");

  return g_bc_clobber_complement_target;
}

s16 allocatorRaBcClobberSignedAssignment(s8 a) {

  __asm(".DB \"03>\"");
  g_bc_clobber_assignment_target = a;
  __asm(".DB \"<03\"");

  return g_bc_clobber_assignment_target;
}

u8 allocatorRaBcClobberJump8(u8 a, u8 b) {

  if (a == b)
    return 1;

  return 2;
}

void main(void) {
}

u16 g_allocator_core_probe_target = 0;

u8 allocatorRaCoreProbeNearerA(u8 a, u8 b, u8 c) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (a + b) + ((c + 1) + c);
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaCoreProbeNearerHl(u16 a, u16 b, u16 c) {

  u16 out;

  __asm(".DB \"02>\"");
  out = (a + b) + ((c + 1) + c);
  __asm(".DB \"<02\"");

  return out;
}

u8 allocatorRaCoreProbeBoundary(u8 a, u8 b, u8 c, u8 d) {

  u8 out;

  __asm(".DB \"03>\"");
  out = (a + b) + (c + d);
  __asm(".DB \"<03\"");

  return out;
}

u16 allocatorRaCoreProbePreservingOverlap(u16 a, u16 b, u16 c) {

  u16 out;

  __asm(".DB \"04>\"");
  out = (a + b) + (~c);
  g_allocator_core_probe_target = out;
  __asm(".DB \"<04\"");

  return g_allocator_core_probe_target;
}


u8 g_allocator_get_address_index_values_a[256];
u16 g_allocator_get_address_index_values_hl[512];
u16 g_allocator_get_address_index_sink;

u16 allocatorRaGetAddressArrayIndexA(u8 left, u8 right, u16 mask) {

  u16 out;

  __asm(".DB \"01>\"");
  out = (&g_allocator_get_address_index_values_a[left + right]) ^ mask;
  g_allocator_get_address_index_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaGetAddressArrayIndexHl(u16 left, u16 right, u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = (&g_allocator_get_address_index_values_hl[left ^ right]) ^ mask;
  g_allocator_get_address_index_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}

u8 allocatorRaSplitReloadNonzeroByte(u8 **roots, u8 root_left, u8 root_right, u8 index_left, u8 index_right) {

  u8 *target;

  target = roots[root_left + root_right];

  __asm(".DB \"01>\"");
  target[index_left + index_right] = target[index_left + index_right] + 1;
  __asm(".DB \"<01\"");

  return index_left;
}

u16 allocatorRaSplitReloadNonzeroWord(u16 **roots, u8 root_left, u8 root_right, u8 index_left, u8 index_right) {

  u16 *target;

  target = roots[root_left ^ root_right];

  __asm(".DB \"02>\"");
  target[index_left + index_right] = target[index_left + index_right] - 1;
  __asm(".DB \"<02\"");

  return index_right;
}


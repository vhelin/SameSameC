u16 g_complement_source_hl = 0x3c5a;
u16 g_complement_target_hl = 0;

u16 allocatorRaComplementLocationsHl(u16 a, u16 b) {

  __asm(".DB \"01>\"");
  g_complement_target_hl = ~a;
  __asm(".DB \"<01\"");

  __asm(".DB \"02>\"");
  g_complement_target_hl = ~g_complement_source_hl;
  __asm(".DB \"<02\"");

  __asm(".DB \"03>\"");
  g_complement_target_hl = (~a) ^ b;
  __asm(".DB \"<03\"");

  return g_complement_target_hl;
}

void main(void) {
}
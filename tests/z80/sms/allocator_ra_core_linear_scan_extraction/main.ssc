u16 allocatorRaCoreLinearScanNearer(u16 a, u16 b, u16 c) {

  u16 out;

  __asm(".DB \"01>\"");
  out = (a + b) + ((c + 1) + c);
  __asm(".DB \"<01\"");

  return out;
}

u8 allocatorRaCoreLinearScanEqual(u8 **roots, u8 root_left, u8 root_right, u8 index_left, u8 index_right) {

  u8 *target;

  target = roots[root_left + root_right];

  __asm(".DB \"02>\"");
  target[index_left + index_right] = target[index_left + index_right] + 1;
  __asm(".DB \"<02\"");

  return index_left;
}

void main(void) {
}

u8 g_allocator_array_write_index_values_a[256];
u16 g_allocator_array_write_index_values_hl[256];
u8 g_allocator_array_write_signed_values_a[256];
u8 g_allocator_array_write_promoted_index_hl[256];

u8 allocatorRaArrayWriteIndexA(u8 left, u8 right, u8 value) {

  __asm(".DB \"01>\"");
  g_allocator_array_write_index_values_a[left + right] = value;
  __asm(".DB \"<01\"");

  return value;
}

u16 allocatorRaArrayWriteIndexHl(u16 left, u16 right, u16 value) {

  __asm(".DB \"02>\"");
  g_allocator_array_write_index_values_hl[left ^ right] = value;
  __asm(".DB \"<02\"");

  return value;
}

u8 allocatorRaZ80OutWriteIndexA(u8 left, u8 right, u8 value) {

  __asm(".DB \"03>\"");
  __z80_out[left + right] = value;
  __asm(".DB \"<03\"");

  return value;
}

u8 allocatorRaArrayWriteSignedIndexPreserveA(s8 index, u8 left, u8 right) {

  __asm(".DB \"04>\"");
  g_allocator_array_write_signed_values_a[index] = left + right;
  __asm(".DB \"<04\"");

  return left;
}

u8 allocatorRaArrayWritePromotedIndexHl(u8 index, u8 value) {

  u16 i;

  __asm(".DB \"05>\"");
  g_allocator_array_write_promoted_index_hl[144 + index] = value;
  __asm(".DB \"<05\"");

  for (i = 0; i < sizeof(g_allocator_array_write_promoted_index_hl); i++)
    __z80_out[0xBE] = g_allocator_array_write_promoted_index_hl[i];

  return value;
}

void main(void) {
}
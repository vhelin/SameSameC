u16 constantMultiplyRight(u16 value) {

  u16 result;

  __asm(".DB \"01>\"");
  result = value * 3;
  __asm(".DB \"<01\"");
  return result;
}

u16 constantMultiplyLeft(u16 value) {

  u16 result;

  __asm(".DB \"02>\"");
  result = 73 * value;
  __asm(".DB \"<02\"");
  return result;
}

s16 constantMultiplySigned(s16 value) {

  s16 result;

  __asm(".DB \"03>\"");
  result = value * (-32767);
  __asm(".DB \"<03\"");
  return result;
}

u16 constantMultiplyBound(u16 value) {

  u16 result;

  __asm(".DB \"04>\"");
  result = value * 511;
  __asm(".DB \"<04\"");
  return result;
}

u16 constantMultiplyFallback(u16 value) {

  u16 result;

  __asm(".DB \"05>\"");
  result = value * 1023;
  __asm(".DB \"<05\"");
  return result;
}

u16 variableMultiply(u16 value, u16 factor) {

  u16 result;

  __asm(".DB \"06>\"");
  result = value * factor;
  __asm(".DB \"<06\"");
  return result;
}

u16 constantMultiplySignedByte(s8 value) {

  u16 result;

  __asm(".DB \"07>\"");
  result = 257 * value;
  __asm(".DB \"<07\"");
  return result;
}

s16 variableSignedMultiply(s16 value, s16 factor) {

  s16 result;

  __asm(".DB \"08>\"");
  result = value * factor;
  __asm(".DB \"<08\"");
  return result;
}

u16 variableSignedByteMultiply(s8 value, u16 factor) {

  u16 result;

  __asm(".DB \"09>\"");
  result = value * factor;
  __asm(".DB \"<09\"");
  return result;
}

u8 variableByteMultiply(u8 value, u8 factor) {

  u8 result;

  __asm(".DB \"10>\"");
  result = value * factor;
  __asm(".DB \"<10\"");
  return result;
}


u16 allocatorRaArrayWriteBcBaseHlIndex(u16 *target, u16 left, u16 right, u16 value) {

  __asm(".DB \"01>\"");
  target[left ^ right] = value;
  __asm(".DB \"<01\"");

  return value;
}


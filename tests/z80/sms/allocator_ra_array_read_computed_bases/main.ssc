struct AllocatorRaArrayReadComputedBaseStruct {
  u8 pad;
  u8 byte_value;
  u16 word_value;
};

struct AllocatorRaArrayReadComputedBaseStruct g_allocator_array_read_computed_base_struct;
u8 g_allocator_array_read_computed_base_sink_a;
u16 g_allocator_array_read_computed_base_sink_hl;

u8 allocatorRaArrayReadComputedBaseA(u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = g_allocator_array_read_computed_base_struct.byte_value ^ mask;
  g_allocator_array_read_computed_base_sink_a = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaArrayReadComputedBaseHl(u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = g_allocator_array_read_computed_base_struct.word_value ^ mask;
  g_allocator_array_read_computed_base_sink_hl = out;
  __asm(".DB \"<02\"");

  return out;
}


u8 g_allocator_mul_div_mod_sink_a;
u16 g_allocator_mul_div_mod_sink_hl;

u8 allocatorRaMulResultA(u8 left, u8 right, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (left * right) ^ mask;
  g_allocator_mul_div_mod_sink_a = out;
  __asm(".DB \"<01\"");

  return out;
}

u8 allocatorRaDivResultA(u8 left, u8 right, u8 mask) {

  u8 out;

  __asm(".DB \"02>\"");
  out = (left / right) ^ mask;
  g_allocator_mul_div_mod_sink_a = out;
  __asm(".DB \"<02\"");

  return out;
}

u8 allocatorRaModResultA(u8 left, u8 right, u8 mask) {

  u8 out;

  __asm(".DB \"03>\"");
  out = (left % right) ^ mask;
  g_allocator_mul_div_mod_sink_a = out;
  __asm(".DB \"<03\"");

  return out;
}

u16 allocatorRaMulResultHl(u16 left, u16 right, u16 mask) {

  u16 out;

  __asm(".DB \"04>\"");
  out = (left * right) ^ mask;
  g_allocator_mul_div_mod_sink_hl = out;
  __asm(".DB \"<04\"");

  return out;
}

u16 allocatorRaDivResultHl(u16 left, u16 right, u16 mask) {

  u16 out;

  __asm(".DB \"05>\"");
  out = (left / right) ^ mask;
  g_allocator_mul_div_mod_sink_hl = out;
  __asm(".DB \"<05\"");

  return out;
}

u16 allocatorRaModResultHl(u16 left, u16 right, u16 mask) {

  u16 out;

  __asm(".DB \"06>\"");
  out = (left % right) ^ mask;
  g_allocator_mul_div_mod_sink_hl = out;
  __asm(".DB \"<06\"");

  return out;
}


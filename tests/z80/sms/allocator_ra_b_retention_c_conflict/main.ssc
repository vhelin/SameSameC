u8 g_allocator_b_retention_target;

u8 allocatorRaBRetentionCConflict(u8 a, u8 b, u8 c, u8 d, u8 e, u8 f, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (a + b) ^ ((c + d) ^ (e + f));
  out = out ^ mask;
  g_allocator_b_retention_target = out;
  __asm(".DB \"<01\"");

  return out;
}

u8 allocatorRaAssignmentC(u8 value, u8 left, u8 right) {

  u8 out;

  __asm(".DB \"02>\"");
  out = value;
  while (left + out) {
    out = out << 1;
    left = left - 1;
  }
  out = out ^ right;
  g_allocator_b_retention_target = out;
  __asm(".DB \"<02\"");

  return out;
}

u8 allocatorRaAssignmentCCompare(u8 value, u8 limit, u8 mask) {

  u8 out = value;

  while (out < limit) {
    out = out << 1;
  }

  return out ^ mask;
}


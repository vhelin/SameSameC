u8 g_allocator_b_retention_target;

u8 allocatorRaBRetentionCConflict(u8 a, u8 b, u8 c, u8 d, u8 e, u8 f, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (a + b) ^ ((c + d) ^ (e + f));
  out = out ^ mask;
  g_allocator_b_retention_target = out;
  __asm(".DB \"<01\"");

  return out;
}


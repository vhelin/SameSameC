void allocatorRaBoundarySpillReasonSinkHl(u16 value) {
}

u16 g_allocator_boundary_values_hl[256];

u16 allocatorRaBoundarySpillReasonCallHl(u16 a, u16 b) {

  __asm(".DB \"01>\"");
  allocatorRaBoundarySpillReasonSinkHl(a + b);
  __asm(".DB \"<01\"");

  return a;
}

u16 allocatorRaBoundarySpillReasonReturnHl(u16 a, u16 b) {

  __asm(".DB \"02>\"");
  if (a) {
    return a + b;
  }
  __asm(".DB \"<02\"");

  return b;
}

u16 allocatorRaBoundarySpillReasonUnmigratedHl(u16 a, u16 b) {

  __asm(".DB \"03>\"");
  if (a) {
    g_allocator_boundary_values_hl[a + b] = b;
    return a;
  }
  __asm(".DB \"<03\"");

  return b;
}


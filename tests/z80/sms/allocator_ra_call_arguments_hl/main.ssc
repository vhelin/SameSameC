u16 g_call_source_hl = 0x1234;

void allocatorRaCallArgumentsSinkHl(u16 constant_value, u16 stack_value, u16 global_value, u16 temp_value, s16 extended_value) {
}

void allocatorRaCallArgumentsHl(u16 a, u16 b, s8 small) {


u8 g_allocator_array_read_pointer_base_sink_a;
u16 g_allocator_array_read_pointer_base_sink_hl;

u8 allocatorRaArrayReadPointerBaseA(u8 *source, u8 left, u8 right, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = source[left + right] ^ mask;
  g_allocator_array_read_pointer_base_sink_a = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaArrayReadPointerBaseHl(u16 *source, u16 left, u16 right, u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = source[left ^ right] ^ mask;
  g_allocator_array_read_pointer_base_sink_hl = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}

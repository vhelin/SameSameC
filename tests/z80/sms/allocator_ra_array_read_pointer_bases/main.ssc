u8 g_allocator_array_read_pointer_base_sink_a;
u16 g_allocator_array_read_pointer_base_sink_hl;

u8 allocatorRaArrayReadPointerBaseA(u8 *source, u8 left, u8 right, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = source[left + right] ^ mask;
  g_allocator_array_read_pointer_base_sink_a = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaArrayReadPointerBaseHl(u16 *source, u16 left, u16 right, u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = source[left ^ right] ^ mask;
  g_allocator_array_read_pointer_base_sink_hl = out;
  __asm(".DB \"<02\"");

  return out;
}

u8 g_allocator_rematerialized_base[4];

u8 allocatorRaRematerializedBase(u8 first, u8 second) {

  u8 *base;
  u8 out;

  __asm(".DB \"03>\"");
  base = &g_allocator_rematerialized_base[0];
  out = base[first];
  out = out + base[second];
  __asm(".DB \"<03\"");

  return out;
}

u8 allocatorRaAddressReload(u8 first, u8 second) {

  u8 *base;
  u8 *slice;
  u8 out;

  __asm(".DB \"04>\"");
  base = &g_allocator_rematerialized_base[first];
  out = base[0];
  slice = &base[second];
  out = out + slice[0];
  out = out + base[1];
  __asm(".DB \"<04\"");

  return out;
}

u8 allocatorRaRematerializedFallback(u8 *source, u8 first, u8 second) {

  u8 *base;
  u8 out;

  base = &source[first];
  out = base[0] + base[second];
  __asm("NOP");
  out = out + base[1];

  return out;
}

void main(void) {
}

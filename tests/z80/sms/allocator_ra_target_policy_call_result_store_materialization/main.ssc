u16 g_allocator_call_result_store_word;

u16 allocatorRaPolicyCallResultStoreWordCallee(u16 value) __orga 0x0300 {

  return value + 1;
}

void allocatorRaPolicyCallResultStoreGlobal(u16 value) {

  __asm(".DB \"01>\"");
  g_allocator_call_result_store_word = allocatorRaPolicyCallResultStoreWordCallee(value);
  __asm(".DB \"<01\"");
}

void allocatorRaPolicyCallResultStoreLocal(u16 value, u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = allocatorRaPolicyCallResultStoreWordCallee(value);
  g_allocator_call_result_store_word = out ^ mask;
  __asm(".DB \"<02\"");
}

void allocatorRaPolicyCallResultStoreFar(u16 value, u16 mask) {

  u8 padding[140];
  u16 out;

  padding[0] = 1;

  __asm(".DB \"03>\"");
  out = allocatorRaPolicyCallResultStoreWordCallee(value + padding[0]);
  g_allocator_call_result_store_word = out ^ mask;
  __asm(".DB \"<03\"");
}

u16 allocatorRaPolicyCallResultStoreRetained(u16 value, u16 mask) {

  u16 out;

  __asm(".DB \"04>\"");
  out = allocatorRaPolicyCallResultStoreWordCallee(value) ^ mask;
  g_allocator_call_result_store_word = out;
  __asm(".DB \"<04\"");

  return out;
}


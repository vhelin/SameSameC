u8 g_allocator_all_spill_values[256];

u8 allocatorAllSpillMetadata(u8 a, u8 b, u8 c) {

  u8 d;

  __asm(".DB \"01>\"");
  g_allocator_all_spill_values[a + b] = c;
  d = c;
  __asm(".DB \"<01\"");

  return d;
}


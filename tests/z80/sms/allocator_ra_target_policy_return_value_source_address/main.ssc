u8 g_allocator_return_source_byte;
u16 g_allocator_return_source_word;

u8 allocatorRaPolicyReturnSourceGlobalByte(u8 gate) {

  if (gate) {
    __asm(".DB \"01>\"");
    return g_allocator_return_source_byte;
  }
  __asm(".DB \"<01\"");

  return 0;
}

u8 allocatorRaPolicyReturnSourceNearByte(u8 value) {

  if (value) {
    __asm(".DB \"02>\"");
    return value;
  }
  __asm(".DB \"<02\"");

  return 0;
}

u8 allocatorRaPolicyReturnSourceFarByte(u8 value) {

  u8 padding[140];
  u8 out;

  padding[0] = 1;
  out = value + padding[0];
  if (padding[0]) {
    __asm(".DB \"03>\"");
    return out;
  }
  __asm(".DB \"<03\"");

  return 0;
}

u16 allocatorRaPolicyReturnSourceGlobalWord(u8 gate) {

  if (gate) {
    __asm(".DB \"04>\"");
    return g_allocator_return_source_word;
  }
  __asm(".DB \"<04\"");

  return 0;
}

u16 allocatorRaPolicyReturnSourceNearWord(u16 value) {

  if (value) {
    __asm(".DB \"05>\"");
    return value;
  }
  __asm(".DB \"<05\"");

  return 0;
}

u16 allocatorRaPolicyReturnSourceFarWord(u16 value) {

  u8 padding[140];
  u16 out;

  padding[0] = 1;
  out = value + padding[0];
  if (padding[0]) {
    __asm(".DB \"06>\"");
    return out;
  }
  __asm(".DB \"<06\"");

  return 0;
}

s16 allocatorRaPolicyReturnSourceSignedWiden(s8 value) {

  if (value) {
    __asm(".DB \"07>\"");
    return value;
  }
  __asm(".DB \"<07\"");

  return 0;
}

u16 allocatorRaPolicyReturnSourceUnsignedWiden(u8 value) {

  if (value) {
    __asm(".DB \"08>\"");
    return value;
  }
  __asm(".DB \"<08\"");

  return 0;
}

u8 allocatorRaPolicyReturnSourceRetainedA(u8 left, u8 right) {

  if (left) {
    __asm(".DB \"09>\"");
    return left + right;
  }
  __asm(".DB \"<09\"");

  return 0;
}

u16 allocatorRaPolicyReturnSourceRetainedHl(u16 left, u16 right) {

  if (left) {
    __asm(".DB \"10>\"");
    return left + right;
  }
  __asm(".DB \"<10\"");

  return 0;
}

u8 allocatorRaPolicyReturnSourceConstant(u8 gate) {

  if (gate) {
    __asm(".DB \"11>\"");
    return 0x5a;
  }
  __asm(".DB \"<11\"");

  return 0;
}


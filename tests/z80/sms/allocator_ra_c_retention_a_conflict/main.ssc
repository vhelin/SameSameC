u8 g_allocator_c_retention_target;

u8 allocatorRaCRetentionAConflict(u8 a, u8 b, u8 c, u8 d, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (a + b) ^ (c + d);
  out = out ^ mask;
  g_allocator_c_retention_target = out;
  __asm(".DB \"<01\"");

  return out;
}


struct AllocatorRaStructPointerArrayLeaf {
  u8 pad;
  u8 byte_value;
  u16 word_value;
};

struct AllocatorRaStructPointerArrayLeaf *g_allocator_struct_pointer_array[8];
u16 g_allocator_struct_pointer_array_sink;

u8 allocatorRaStructPointerArrayWrite(u8 index_left, u8 index_right, u8 left, u8 right) {

  __asm(".DB \"01>\"");
  g_allocator_struct_pointer_array[index_left + index_right]->byte_value = left + right;
  __asm(".DB \"<01\"");

  return left;
}

u16 allocatorRaStructPointerArrayRead(u8 index_left, u8 index_right, u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = g_allocator_struct_pointer_array[index_left + index_right]->word_value ^ mask;
  g_allocator_struct_pointer_array_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}

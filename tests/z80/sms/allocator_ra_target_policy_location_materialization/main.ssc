u8 g_allocator_location_byte_sink;
u16 g_allocator_location_word_sink;
u8 g_allocator_location_values_a[16];
u16 g_allocator_location_values_hl[16];

u8 allocatorRaPolicyLocationB(u8 a, u8 b, u8 c, u8 d, u8 e, u8 f, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (a + b) ^ ((c + d) ^ (e + f));
  out = out ^ mask;
  g_allocator_location_byte_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaPolicyLocationBc(u16 a, u16 b, u16 c) {

  u16 out;

  __asm(".DB \"02>\"");
  out = (a + b) + (~c);
  g_allocator_location_word_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

u8 allocatorRaPolicyLocationC(u8 a, u8 b, u8 c, u8 d, u8 mask) {

  u8 out;

  __asm(".DB \"03>\"");
  out = (a + b) ^ (c + d);
  out = out ^ mask;
  g_allocator_location_byte_sink = out;
  __asm(".DB \"<03\"");

  return out;
}

u8 allocatorRaPolicyLocationA(u8 index, u8 mask) {

  u8 out;

  __asm(".DB \"04>\"");
  out = g_allocator_location_values_a[index] ^ mask;
  g_allocator_location_byte_sink = out;
  __asm(".DB \"<04\"");

  return out;
}

u16 allocatorRaPolicyLocationHl(u8 index, u16 mask) {

  u16 out;

  __asm(".DB \"05>\"");
  out = g_allocator_location_values_hl[index] ^ mask;
  g_allocator_location_word_sink = out;
  __asm(".DB \"<05\"");

  return out;
}

void allocatorRaPolicyLocationConstant(u8 value) {

  __asm(".DB \"06>\"");
  g_allocator_location_byte_sink = value ^ 0x5a;
  __asm(".DB \"<06\"");
}

void allocatorRaPolicyLocationSpillSink(u8 byte_value, u16 word_value) {

  g_allocator_location_byte_sink = byte_value;
  g_allocator_location_word_sink = word_value;
}

void allocatorRaPolicyLocationSpill(u8 left, u8 right, u16 word_value) {

  __asm(".DB \"07>\"");
  allocatorRaPolicyLocationSpillSink(left + right, word_value + 1);
  __asm(".DB \"<07\"");
}

void main(void) {
}

union AllocatorRaUnionPointerArrayValue {
  u8 byte_value;
  u16 word_value;
};

union AllocatorRaUnionPointerArrayValue *g_allocator_union_pointer_array[8];
u16 g_allocator_union_pointer_array_sink;

u8 allocatorRaUnionPointerArrayWrite(u8 index_left, u8 index_right, u8 left, u8 right) {

  __asm(".DB \"01>\"");
  g_allocator_union_pointer_array[index_left + index_right]->byte_value = left + right;
  __asm(".DB \"<01\"");

  return left;
}

u16 allocatorRaUnionPointerArrayRead(u8 index_left, u8 index_right, u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = g_allocator_union_pointer_array[index_left + index_right]->word_value ^ mask;
  g_allocator_union_pointer_array_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

u8 allocatorRaUnionPointerArrayIncrement(u8 index_left, u8 index_right) {

  __asm(".DB \"03>\"");
  g_allocator_union_pointer_array[index_left + index_right]->byte_value++;
  __asm(".DB \"<03\"");

  return index_left;
}

u16 allocatorRaUnionPointerArrayDecrement(u8 index_left, u8 index_right) {

  __asm(".DB \"04>\"");
  g_allocator_union_pointer_array[index_left + index_right]->word_value--;
  __asm(".DB \"<04\"");

  return index_right;
}

void main(void) {
}

u8 g_allocator_uncached_address_operand;
u8 g_allocator_uncached_address_sink;

u8 allocatorRaPolicyUncachedMulLocal(u8 left, u8 right, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (left * right) ^ mask;
  g_allocator_uncached_address_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

u8 allocatorRaPolicyUncachedDivGlobal(u8 left, u8 mask) {

  u8 out;

  __asm(".DB \"02>\"");
  out = (left / g_allocator_uncached_address_operand) ^ mask;
  g_allocator_uncached_address_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

u8 allocatorRaPolicyUncachedModFar(u8 left, u8 right, u8 mask) {

  u8 padding[140];
  u8 far_right;
  u8 out;

  __asm(".DB \"03>\"");
  padding[0] = 1;
  far_right = right + padding[0];
  out = (left % far_right) ^ mask;
  g_allocator_uncached_address_sink = out;
  __asm(".DB \"<03\"");

  return out;
}


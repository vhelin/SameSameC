u8 g_allocator_core_liveness_sink;

u8 allocatorRaCoreLivenessDiamond(u8 left, u8 right, u8 condition) {

  __asm(".DB \"01>\"");
  if (left == right) {
    condition = condition + 1;
  }
  else {
    condition = condition + 2;
  }
  g_allocator_core_liveness_sink = condition;
  __asm(".DB \"<01\"");

  return g_allocator_core_liveness_sink;
}

u8 allocatorRaCoreLivenessLoop(u8 count, u8 value) {

  __asm(".DB \"02>\"");
  while (count + value) {
    value = value + 1;
    count = count - 1;
  }
  g_allocator_core_liveness_sink = value;
  __asm(".DB \"<02\"");

  return g_allocator_core_liveness_sink;
}

u8 allocatorRaCoreLivenessLoopJoin(u8 count, u8 value) {

  value = value + 0;
  while (count + value) {
    value = value + 1;
    count = count - 1;
  }

  return value;
}

u16 allocatorRaCoreLivenessLoopJoin16(u8 count, u16 value) {

  value = value + 0;
  while (count + value) {
    value = value + 1;
    count = count - 1;
  }

  return value;
}

u8 allocatorRaCoreLivenessTwoLoops(u8 count1, u8 value1, u8 count2, u8 value2) {

  value1 = value1 + 0;
  while (count1 + value1) {
    value1 = value1 + 1;
    count1 = count1 - 1;
  }
  g_allocator_core_liveness_sink = value1;

  value2 = value2 + 0;
  while (count2 + value2) {
    value2 = value2 + 1;
    count2 = count2 - 1;
  }

  return value2;
}

u8 allocatorRaCoreLivenessLoopConflict(u8 count1, u8 value1, u8 count2, u8 value2) {

  value1 = value1 + 0;
  while (count1 + value1) {
    value1 = value1 + 1;
    count1 = count1 - 1;
  }

  value2 = value2 + 0;
  while (count2 + value2) {
    value2 = value2 + 1;
    count2 = count2 - 1;
  }

  return value1 + value2;
}

u8 allocatorRaCoreLivenessMultiValue(u8 count, u8 value1, u8 value2) {

  value1 = value1 + 0;
  value2 = value2 + 0;
  while (count + value1 + value2) {
    value1 = value1 + 1;
    value2 = value2 + 2;
    count = count - 1;
  }

  return value1 + value2;
}

u8 allocatorRaCoreLivenessNestedLoops(u8 outerCount, u8 outerValue, u8 innerCount, u8 innerValue) {

  outerValue = outerValue + 0;
  while (outerCount + outerValue) {
    innerValue = innerValue + 0;
    while (innerCount + innerValue) {
      innerValue = innerValue + 1;
      innerCount = innerCount - 1;
    }
    outerValue = outerValue + 1;
    outerCount = outerCount - 1;
  }

  return outerValue + innerValue;
}

u16 allocatorRaCoreLivenessNestedDisjoint(u8 outerCount, u8 outerValue, u8 innerCount, u16 innerValue) {

  outerValue = outerValue + 0;
  while (outerCount + outerValue) {
    innerValue = innerValue + 0;
    while (innerCount + innerValue) {
      innerValue = innerValue + 1;
      innerCount = innerCount - 1;
    }
    g_allocator_core_liveness_sink = innerValue;
    outerValue = outerValue + 1;
    outerCount = outerCount - 1;
  }

  return innerValue + outerValue;
}

u8 allocatorRaCoreLivenessNestedConflict(u8 outerCount, u8 outerValue, u8 innerCount, u8 innerValue) {

  outerValue = outerValue + 0;
  while (outerCount + outerValue) {
    innerValue = innerValue + 0;
    while (innerCount + innerValue) {
      innerValue = innerValue + 1;
      innerCount = innerCount - 1;
    }
    g_allocator_core_liveness_sink = innerValue;
    outerValue = outerValue + 1;
    outerCount = outerCount - 1;
  }

  return innerValue + outerValue;
}

u8 allocatorRaCoreLivenessBreakExit(u8 count, u8 value, u8 stop) {

  value = value + 0;
  while (count + value) {
    if (stop)
      break;
    value = value + 1;
    count = count - 1;
  }

  return value;
}

u8 allocatorRaCoreLivenessContinueExit(u8 count, u8 value, u8 skip) {

  value = value + 0;
  while (count + value) {
    if (skip)
      continue;
    value = value + 1;
    count = count - 1;
  }

  return value;
}

u8 allocatorRaCoreLivenessEarlyReturn(u8 count, u8 value, u8 stop) {

  value = value + 0;
  while (count + value) {
    if (stop)
      return value;
    value = value + 1;
    count = count - 1;
  }

  return value;
}

u8 allocatorRaCoreLivenessMultiLatchWriters(u8 count, u8 value, u8 skip) {

  value = value + 0;
  while (count + value) {
    if (skip) {
      value = value + 2;
      count = count - 1;
      continue;
    }
    value = value + 1;
    count = count - 1;
  }

  return value;
}


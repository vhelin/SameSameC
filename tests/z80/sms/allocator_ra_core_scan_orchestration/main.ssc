u8 allocatorRaCoreScanOrchestrationA(u8 a, u8 b, u8 c) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (a + b) + ((c + 1) + c);
  __asm(".DB \"<01\"");

  return out;
}


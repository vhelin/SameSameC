u16 g_allocator_get_address_computed_base_sink;

u16 allocatorRaGetAddressComputedBaseA(u8 *source, u16 mask) {

  u16 out;

  __asm(".DB \"01>\"");
  out = (&source[1]) ^ mask;
  g_allocator_get_address_computed_base_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaGetAddressComputedBaseHl(u16 *source, u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = (&source[2]) ^ mask;
  g_allocator_get_address_computed_base_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {

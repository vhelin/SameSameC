u16 g_allocator_get_address_pointer_base_sink;

u16 allocatorRaGetAddressPointerBaseA(u8 *source, u8 left, u8 right, u16 mask) {

  u16 out;

  __asm(".DB \"01>\"");
  out = (&source[left + right]) ^ mask;
  g_allocator_get_address_pointer_base_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaGetAddressPointerBaseHl(u16 *source, u16 left, u16 right, u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = (&source[left ^ right]) ^ mask;
  g_allocator_get_address_pointer_base_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}

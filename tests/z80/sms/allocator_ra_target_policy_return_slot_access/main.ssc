s16 g_allocator_return_signed;
u16 g_allocator_return_unsigned;
u16 g_allocator_return_word;

s8 allocatorRaPolicyReturnSignedByte(s8 value) {

  return value + 1;
}

u8 allocatorRaPolicyReturnUnsignedByte(u8 value) {

  return value + 2;
}

u16 allocatorRaPolicyReturnWord(u16 value) {

  return value + 0x0103;
}

void allocatorRaPolicyReturnSlotAccess(s8 signed_value, u8 unsigned_value, u16 word_value) {

  __asm(".DB \"01>\"");
  g_allocator_return_signed = allocatorRaPolicyReturnSignedByte(signed_value);
  __asm(".DB \"<01\"");

  __asm(".DB \"02>\"");
  g_allocator_return_unsigned = allocatorRaPolicyReturnUnsignedByte(unsigned_value);
  __asm(".DB \"<02\"");

  __asm(".DB \"03>\"");
  g_allocator_return_word = allocatorRaPolicyReturnWord(word_value);
  __asm(".DB \"<03\"");
}

void main(void) {
}

u8 g_allocator_core_next_use_sink;

u8 allocatorRaCoreNextUseByte(u8 left, u8 right, u8 value) {

  u8 result;

  __asm(".DB \"01>\"");
  result = (left + right) + ((value + 1) + value);
  __asm(".DB \"<01\"");

  return result;
}

u16 allocatorRaCoreNextUseWord(u16 left, u16 right, u16 value) {

  u16 result;

  __asm(".DB \"02>\"");
  result = (left + right) + ((value + 1) + value);
  __asm(".DB \"<02\"");

  return result;
}

u8 allocatorRaCoreNextUseReused(u8 left, u8 right, u8 third, u8 fourth) {

  __asm(".DB \"03>\"");
  g_allocator_core_next_use_sink = (left + right) + third;
  g_allocator_core_next_use_sink = (third + fourth) + left;
  __asm(".DB \"<03\"");

  return g_allocator_core_next_use_sink;
}

void main(void) {
}

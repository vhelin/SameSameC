u8 g_allocator_frame_byte;
u16 g_allocator_frame_word;

void allocatorRaPolicyFrameVoidCallee(u8 value) {

  g_allocator_frame_byte = value;
}

u8 allocatorRaPolicyFrameByteCallee(u8 value) {

  return value + 1;
}

u16 allocatorRaPolicyFrameWordCallee(u16 value) {

  return value + 0x0103;
}

void allocatorRaPolicyCallFramePrefix(u8 byte_value, u16 word_value) {

  __asm(".DB \"01>\"");
  allocatorRaPolicyFrameVoidCallee(byte_value);
  __asm(".DB \"<01\"");

  __asm(".DB \"02>\"");
  g_allocator_frame_byte = allocatorRaPolicyFrameByteCallee(byte_value);
  __asm(".DB \"<02\"");

  __asm(".DB \"03>\"");
  g_allocator_frame_word = allocatorRaPolicyFrameWordCallee(word_value);
  __asm(".DB \"<03\"");
}

void main(void) {
}

u8 g_allocator_target_transparency_byte_sink;
u16 g_allocator_target_transparency_word_sink;

u8 allocatorRaTargetTransparencyByte(u8 a, u8 b, u8 c, u8 d, u8 e, u8 f, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (a + b) ^ ((c + d) ^ (e + f));
  out = out ^ mask;
  g_allocator_target_transparency_byte_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaTargetTransparencyWord(u16 a, u16 b, u16 c, u16 d) {

  u16 held;
  u16 alternate;
  u16 passthrough;
  u16 out;

  __asm(".DB \"02>\"");
  held = a + b;
  alternate = ~c;
  passthrough = ~d;
  out = (held + alternate) ^ passthrough;
  g_allocator_target_transparency_word_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}
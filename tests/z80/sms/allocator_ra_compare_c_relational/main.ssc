u8 g_allocator_compare_c_relational_target;

u8 allocatorRaCompareCRelational(u8 a, u8 b, u8 c, u8 d, u8 e, u8 f) {

  __asm(".DB \"01>\"");
  if ((a + b) < ((c + d) ^ (e + f))) {
    g_allocator_compare_c_relational_target = g_allocator_compare_c_relational_target + 1;
  }
  __asm(".DB \"<01\"");

  __asm(".DB \"02>\"");
  if ((a + b) > ((c + d) ^ (e + f))) {
    g_allocator_compare_c_relational_target = g_allocator_compare_c_relational_target + 1;
  }
  __asm(".DB \"<02\"");

  __asm(".DB \"03>\"");
  if ((a + b) <= ((c + d) ^ (e + f))) {
    g_allocator_compare_c_relational_target = g_allocator_compare_c_relational_target + 1;
  }
  __asm(".DB \"<03\"");

  __asm(".DB \"04>\"");
  if ((a + b) >= ((c + d) ^ (e + f))) {
    g_allocator_compare_c_relational_target = g_allocator_compare_c_relational_target + 1;
  }
  __asm(".DB \"<04\"");

  return g_allocator_compare_c_relational_target;
}

u16 allocatorRaCompareWordLowByte(u8 selector, u16 value) {

  __asm(".DB \"05>\"");
  if (selector & 1)
    value = value + 1;
  __asm(".DB \"<05\"");

  return (value + value) + (value ^ selector);
}


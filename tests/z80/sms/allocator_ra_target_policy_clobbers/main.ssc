u8 g_allocator_policy_clobber_values[16];
u8 g_allocator_policy_clobber_sink;

u8 allocatorRaPolicyClobberHelper(u8 value) {
  return value + 1;
}

u8 allocatorRaPolicyClobberArray(u8 index, u8 left, u8 right) {

  u8 out;

  __asm(".DB \"01>\"");
  out = g_allocator_policy_clobber_values[index] ^ (left + right);
  g_allocator_policy_clobber_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

u8 allocatorRaPolicyClobberCall(u8 value, u8 left, u8 right) {

  u8 out;

  __asm(".DB \"02>\"");
  out = allocatorRaPolicyClobberHelper(value) ^ (left + right);
  g_allocator_policy_clobber_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

u8 allocatorRaPolicyClobberComplement(u8 value, u8 left, u8 right) {

  u8 out;

  __asm(".DB \"03>\"");
  out = (~value) ^ (left + right);
  g_allocator_policy_clobber_sink = out;
  __asm(".DB \"<03\"");

  return out;
}

void main(void) {
}
struct AllocatorRaStructPointerInner {
  u8 pad;
  u8 byte_value;
  u16 word_value;
};

struct AllocatorRaStructPointerOuter {
  u8 pad;
  struct AllocatorRaStructPointerInner *inner;
};

struct AllocatorRaStructPointerInner g_allocator_struct_pointer_inner;
struct AllocatorRaStructPointerOuter g_allocator_struct_pointer_outer;
struct AllocatorRaStructPointerOuter *g_allocator_struct_pointer_outer_ptr;
u16 g_allocator_struct_pointer_sink_hl;

u8 allocatorRaStructPointerFieldWriteA(u8 value_left, u8 value_right) {

  __asm(".DB \"01>\"");
  g_allocator_struct_pointer_outer_ptr->inner->byte_value = value_left + value_right;
  __asm(".DB \"<01\"");

  return value_left;
}

u16 allocatorRaStructPointerFieldReadHl(u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = g_allocator_struct_pointer_outer_ptr->inner->word_value ^ mask;
  g_allocator_struct_pointer_sink_hl = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}
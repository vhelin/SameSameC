static void calculateAndPrintTrampoline(void) {

  u8 one = 1;

  calculateAndPrint(one);
}

static void calculateAndPrint(u8 one) {

  u8 i;

  //////////////////////////////////////////////////////////////////////////////////////////
  // Hello world!
  //////////////////////////////////////////////////////////////////////////////////////////

  const u16 testMessage[] = { 0x28,0x45,0x4c,0x4c,0x4f,0x00,0x37,0x4f,0x52,0x4c,0x44,0x01 };
  u8 *testMessagePtr = testMessage;

  // test string
  __z80_out[0xBF] = 0x00;
  __z80_out[0xBF] = 0x40 | 0x38;
  for (i = 0; i < sizeof(testMessage); i++)
    __z80_out[0xBE] = testMessagePtr[i];

  //////////////////////////////////////////////////////////////////////////////////////////
  // CALCULATIONS
  //////////////////////////////////////////////////////////////////////////////////////////

  u8 chars[80];
  u8 index;
  u16 extra1;
  u16 extra2;
  u16 extra3;
  u8 zero = 1 - one;

  extra1 = (6 + zero) * (7 + zero);
  extra2 = 84 >> one;
  extra3 = calculationMultiplyAdd(5, 8, 2);
  printCalculationLine(chars, 0x40, 0x78, 0x002A, extra1, extra2, extra3);

  extra1 = (0x0F << 4) | 0x0F;
  extra2 = 0x0100 - one;
  extra3 = calculationAdd3(0x70, 0x80, 0x0F);
  extra3 = calculationXorRoundTrip(extra3, 0x55AA);
  printCalculationLine(chars, 0x80, 0x78, 0x00FF, extra1, extra2, extra3);

  extra1 = 0x81 << 2;
  extra2 = calculationMultiplyAdd(0x20, 0x10, 4);
  extra3 = calculationQuotientRoundTrip(0x0204, 7);
  printCalculationLine(chars, 0xC0, 0x78, 0x0204, extra1, extra2, extra3);

  //////////////////////////////////////////////////////////////////////////////////////////
  // $1234 = $1234 = $1234 = $1234
  //////////////////////////////////////////////////////////////////////////////////////////

  index = 0;

  chars[index++] = 0x04; // '$'
  chars[index++] = 0x00;

  convertNumbersToChars16(0x1234, chars, &index); // "1234"

  chars[index++] = 0x00; // ' '
  chars[index++] = 0x00;
  chars[index++] = 0x1D; // '='
  chars[index++] = 0x00;
  chars[index++] = 0x00; // ' '
  chars[index++] = 0x00;

  chars[index++] = 0x04; // '$'
  chars[index++] = 0x00;
  
  u16 result = 0x1111 + ((0x1 << 12) | (0x2 << 8) | (0x3 << 4) | 0x4) - 0x1111;
  convertNumbersToChars16(result, chars, &index); // "1234"

  chars[index++] = 0x00; // ' '
  chars[index++] = 0x00;
  chars[index++] = 0x1D; // '='
  chars[index++] = 0x00;
  chars[index++] = 0x00; // ' '
  chars[index++] = 0x00;

  chars[index++] = 0x04; // '$'
  chars[index++] = 0x00;
  
  u16 var1 = 0x1111;
  u8  var2 = 0x1;
  u8  var3 = 0x2;
  u8  var4 = 4;

  result = var1 + ((var2 << 12) | (var3 << 8) | (0x3 << var4) | var4) - var1;
  convertNumbersToChars16(result, chars, &index); // "1234"

  chars[index++] = 0x00; // ' '
  chars[index++] = 0x00;
  chars[index++] = 0x1D; // '='
  chars[index++] = 0x00;
  chars[index++] = 0x00; // ' '
  chars[index++] = 0x00;

  chars[index++] = 0x04; // '$'
  chars[index++] = 0x00;

  result = var1 + ((var2 << (12 + zero)) | ((var3 | zero) << 8) | ((0x3 - zero) << var4) | (var4 + one - one)) - (var1 - zero);
  convertNumbersToChars16(result, chars, &index); // "1234"

  // output line
  __z80_out[0xBF] = 0x00;
  __z80_out[0xBF] = 0x41 | 0x38;
  for (i = 0; i < index; i++)
    __z80_out[0xBE] = chars[i];

  extra1 = calculationMultiplyAdd(0x33, 0x10, 3);
  extra2 = calculationAdd3(0x0100, 0x0200, 0x0033);
  extra3 = calculationQuotientRoundTrip(extra2, 11);
  printCalculationLine(chars, 0x40, 0x79, 0x0333, extra1, extra2, extra3);

  extra1 = calculationMultiplyAdd(0x55, 0x10, 5);
  extra2 = 0x0AAA >> one;
  extra3 = calculationXorRoundTrip(extra1, 0xA55A);
  printCalculationLine(chars, 0x80, 0x79, 0x0555, extra1, extra2, extra3);

  extra1 = (0x7E + zero) << 4;
  extra2 = 0x0800 - 0x20;
  extra3 = calculationAdd3(0x0700, 0x00D0, 0x0010);
  extra3 = calculationXorRoundTrip(extra3, 0x3C3C);
  printCalculationLine(chars, 0xC0, 0x79, 0x07E0, extra1, extra2, extra3);

  //////////////////////////////////////////////////////////////////////////////////////////
  // $1099 = $1099 = $1099 = $1099
  //////////////////////////////////////////////////////////////////////////////////////////

  index = 0;

  chars[index++] = 0x04; // '$'
  chars[index++] = 0x00;

  convertNumbersToChars16(0x1099, chars, &index); // "1099"

  chars[index++] = 0x00; // ' '
  chars[index++] = 0x00;
  chars[index++] = 0x1D; // '='
  chars[index++] = 0x00;
  chars[index++] = 0x00; // ' '
  chars[index++] = 0x00;

  chars[index++] = 0x04; // '$'
  chars[index++] = 0x00;
  
  result = 250 * 17 - 1;
  convertNumbersToChars16(result, chars, &index); // "1099"

  chars[index++] = 0x00; // ' '
  chars[index++] = 0x00;
  chars[index++] = 0x1D; // '='
  chars[index++] = 0x00;
  chars[index++] = 0x00; // ' '
  chars[index++] = 0x00;

  chars[index++] = 0x04; // '$'
  chars[index++] = 0x00;

  u16 var5 = 250;
  u8  var6 = 17;
  u8  var7 = 1;

  result = var5 * var6 - var7;
  convertNumbersToChars16(result, chars, &index); // "1099"

  chars[index++] = 0x00; // ' '
  chars[index++] = 0x00;
  chars[index++] = 0x1D; // '='
  chars[index++] = 0x00;
  chars[index++] = 0x00; // ' '
  chars[index++] = 0x00;

  chars[index++] = 0x04; // '$'
  chars[index++] = 0x00;

  result = (var5 | zero) * (one + var6 - one) - (var7 + zero);
  convertNumbersToChars16(result, chars, &index); // "1099"

  // output line
  __z80_out[0xBF] = 0x00;
  __z80_out[0xBF] = 0x42 | 0x38;
  for (i = 0; i < index; i++)
    __z80_out[0xBE] = chars[i];

  extra1 = (0x00AC << 4) | 0x000E;
  extra2 = calculationAdd3(0x0800, 0x0200, 0x00CE);
  extra3 = calculationQuotientRoundTrip(extra2, 13);
  printCalculationLine(chars, 0x40, 0x7A, 0x0ACE, extra1, extra2, extra3);

  extra1 = calculationAdd3(0x1000, 0x0300, 0x0057);
  extra2 = calculationMultiplyAdd(0x0135, 0x0010, 7);
  extra3 = calculationXorRoundTrip(extra2, 0x5AA5);
  printCalculationLine(chars, 0x80, 0x7A, 0x1357, extra1, extra2, extra3);

  extra1 = 0x1234 << one;
  extra2 = calculationMultiplyAdd(0x0246, 0x0010, 8);
  extra3 = calculationAdd3(0x2000, 0x0400, 0x0068);
  extra3 = calculationQuotientRoundTrip(extra3, 17);
  printCalculationLine(chars, 0xC0, 0x7A, 0x2468, extra1, extra2, extra3);

  u8 *reg = 0xffff;

  // calculateAndPrint3() is on ROM BANK 2 SLOT 2, so we'll switch that to SLOT 2
  reg[0] = 2;
  calculateAndPrint3(chars, one, zero);

  // calculateAndPrint4() is on ROM BANK 3 SLOT 2, so we'll switch that to SLOT 2
  reg[0] = 3;

  calculateAndPrint4(chars, one, zero);

  // calculateAndPrint5() is on ROM BANK 1 SLOT 2, so we'll switch that to SLOT 2
  reg[0] = 1;

  calculateAndPrint5(chars, one, zero);
}

void calculateAndPrint3(u8 *chars, u8 one, u8 zero);
void calculateAndPrint4(u8 *chars, u8 one, u8 zero);
void calculateAndPrint5(u8 *chars, u8 one, u8 zero);

void convertNumbersToChars16(u16 value, u8 *chars, u8 *index) {

  u8 j = index[0];
  u8 v;

  v = (value >> 12) & 0xF;
  if (v < 10)
    v += 0x10;
  else
    v += 0x17;
  chars[j++] = v;
  chars[j++] = 0x00;

  v = (value >> 8) & 0xF;
  if (v < 10)
    v += 0x10;
  else
    v += 0x17;
  chars[j++] = v;
  chars[j++] = 0x00;

  v = (value >> 4) & 0xF;
  if (v < 10)
    v += 0x10;
  else
    v += 0x17;
  chars[j++] = v;
  chars[j++] = 0x00;

  v = value & 0xF;
  if (v < 10)
    v += 0x10;
  else
    v += 0x17;
  chars[j++] = v;
  chars[j++] = 0x00;

  index[0] = j;
}

static const u8 g_numberToCharacterLUT[] = {
  0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, // 0-9
  0x21, 0x22, 0x23, 0x24, 0x25, 0x26                          // A-F
};

void convertNumbersToChars16QUICK(u16 value, u8 **chars) {

  u8 *ptr = chars[0];
  u8 v;

  v = g_numberToCharacterLUT[value & 0xF];
  ptr[6] = v;
  ptr[7] = 0x00;

  value >>= 4;
  v = g_numberToCharacterLUT[value & 0xF];
  ptr[4] = v;
  ptr[5] = 0x00;

  value >>= 4;
  v = g_numberToCharacterLUT[value & 0xF];
  ptr[2] = v;
  ptr[3] = 0x00;

  value >>= 4;
  v = g_numberToCharacterLUT[value & 0xF];
  ptr[0] = v;
  ptr[1] = 0x00;

  chars[0] = ptr + 8;
}

void printCalculationLine(u8 *chars, u8 addressLow, u8 addressHigh, u16 expected, u16 first, u16 second, u16 third) {

  u8 index = 0;
  u8 i;

  chars[index++] = 0x04;
  chars[index++] = 0x00;
  convertNumbersToChars16(expected, chars, &index);

  chars[index++] = 0x00;
  chars[index++] = 0x00;
  chars[index++] = 0x1D;
  chars[index++] = 0x00;
  chars[index++] = 0x00;
  chars[index++] = 0x00;
  chars[index++] = 0x04;
  chars[index++] = 0x00;
  convertNumbersToChars16(first, chars, &index);

  chars[index++] = 0x00;
  chars[index++] = 0x00;
  chars[index++] = 0x1D;
  chars[index++] = 0x00;
  chars[index++] = 0x00;
  chars[index++] = 0x00;
  chars[index++] = 0x04;
  chars[index++] = 0x00;
  convertNumbersToChars16(second, chars, &index);

  chars[index++] = 0x00;
  chars[index++] = 0x00;
  chars[index++] = 0x1D;
  chars[index++] = 0x00;
  chars[index++] = 0x00;
  chars[index++] = 0x00;
  chars[index++] = 0x04;
  chars[index++] = 0x00;
  convertNumbersToChars16(third, chars, &index);

  __z80_out[0xBF] = addressLow;
  __z80_out[0xBF] = addressHigh;
  for (i = 0; i < index; i++)
    __z80_out[0xBE] = chars[i];
}

u16 calculationAdd3(u16 first, u16 second, u16 third) {

  u16 partial = first + second;
  return partial + third;
}

u16 calculationMultiplyAdd(u16 value, u16 multiplier, u16 addend) {

  u16 product = value * multiplier;
  return product + addend;
}

u16 calculationXorRoundTrip(u16 value, u16 mask) {

  u16 mixed = value ^ mask;
  return mixed ^ mask;
}

u16 calculationQuotientRoundTrip(u16 value, u16 divisor) {

  u16 quotient = value / divisor;
  u16 remainder = value % divisor;
  return quotient * divisor + remainder;
}



// @BT TEST-04 04 START
// @BT DD 21 00 00 DD 19 DD 6E F9 DD 66 FA DD 4E F7 DD 46 F8 09 DD 21 00 C0 44 4D DD 6E 00 DD 66 01 A7 ED 42 CA 36 00 C3 4B 00 DD 21 02 C0 DD 6E 00 DD 66 01 23 DD 21 02 C0 DD 75 00 DD 74 01
// @BT END

u16 g_compare_value_hl = 0x1234;
u16 g_compare_target_hl = 0;

u16 allocatorRaCompareLocationsHlStackGlobal(u16 a) {

  __asm(".DB \"01>\"");
  if (a == g_compare_value_hl) {
    g_compare_target_hl = g_compare_target_hl + 1;
  }
  __asm(".DB \"<01\"");

  return g_compare_target_hl;
}

u16 allocatorRaCompareLocationsHlGlobalConst(void) {

  __asm(".DB \"02>\"");
  if (g_compare_value_hl != 0x1234) {
    g_compare_target_hl = g_compare_target_hl + 1;
  }
  __asm(".DB \"<02\"");

  return g_compare_target_hl;
}

u16 allocatorRaCompareLocationsHlTempGlobal(u16 a, u16 b) {

  __asm(".DB \"03>\"");
  if ((a + b) == g_compare_value_hl) {
    g_compare_target_hl = g_compare_target_hl + 1;
  }
  __asm(".DB \"<03\"");

  return g_compare_target_hl;
}

u16 allocatorRaCompareLocationsHlRetainedArg2(u16 a, u16 b) {

  __asm(".DB \"04>\"");
  switch (g_compare_value_hl) {
    case a + b:
      g_compare_target_hl = g_compare_target_hl + 1;
  }
  __asm(".DB \"<04\"");

  return g_compare_target_hl;
}

void main(void) {
}
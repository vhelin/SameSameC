struct AllocatorRaStructPointerIncrementLeaf {
  u8 byte_value;
  u16 word_value;
};

struct AllocatorRaStructPointerIncrementRoot {
  struct AllocatorRaStructPointerIncrementLeaf *leaf;
};

struct AllocatorRaStructPointerIncrementLeaf g_allocator_struct_pointer_increment_leaf;
struct AllocatorRaStructPointerIncrementRoot g_allocator_struct_pointer_increment_root;
struct AllocatorRaStructPointerIncrementRoot *g_allocator_struct_pointer_increment_root_ptr;

u8 allocatorRaStructPointerIncrementA(void) {

  __asm(".DB \"01>\"");
  g_allocator_struct_pointer_increment_root_ptr->leaf->byte_value++;
  __asm(".DB \"<01\"");

  return g_allocator_struct_pointer_increment_leaf.byte_value;
}

u16 allocatorRaStructPointerDecrementHl(void) {

  __asm(".DB \"02>\"");
  g_allocator_struct_pointer_increment_root_ptr->leaf->word_value--;
  __asm(".DB \"<02\"");

  return g_allocator_struct_pointer_increment_leaf.word_value;
}

void main(void) {
}
u8 g_allocator_assignment_source_byte;
u8 g_allocator_assignment_target_byte;
u16 g_allocator_assignment_source_word;
u16 g_allocator_assignment_target_word;
s16 g_allocator_assignment_target_signed_word;
u8 *g_allocator_assignment_padding;

void allocatorRaPolicyAssignmentGlobalByte(void) {

  __asm(".DB \"01>\"");
  g_allocator_assignment_target_byte = g_allocator_assignment_source_byte;
  __asm(".DB \"<01\"");
}

void allocatorRaPolicyAssignmentNearByte(u8 source, u8 other) {

  u8 result;

  __asm(".DB \"02>\"");
  result = source;
  result = result ^ other;
  __asm(".DB \"<02\"");
  g_allocator_assignment_target_byte = result;
}

void allocatorRaPolicyAssignmentFarByte(u8 left, u8 right) {

  u8 padding[140];
  u8 source;
  u8 result;

  source = left + right;
  g_allocator_assignment_padding = &padding[139];
  __asm("NOP");
  __asm(".DB \"03>\"");
  result = source;
  result = result ^ 1;
  __asm(".DB \"<03\"");
  g_allocator_assignment_target_byte = result;
}

void allocatorRaPolicyAssignmentGlobalWord(void) {

  __asm(".DB \"04>\"");
  g_allocator_assignment_target_word = g_allocator_assignment_source_word;
  __asm(".DB \"<04\"");
}

void allocatorRaPolicyAssignmentNearWord(u16 source, u16 other) {

  u16 result;

  __asm(".DB \"05>\"");
  result = source;
  result = result ^ other;
  __asm(".DB \"<05\"");
  g_allocator_assignment_target_word = result;
}

void allocatorRaPolicyAssignmentFarWord(u16 left, u16 right) {

  u8 padding[140];
  u16 source;
  u16 result;

  source = left ^ right;
  g_allocator_assignment_padding = &padding[139];
  __asm("NOP");
  __asm(".DB \"06>\"");
  result = source;
  result = result ^ 1;
  __asm(".DB \"<06\"");
  g_allocator_assignment_target_word = result;
}

void allocatorRaPolicyAssignmentSignExtend(s8 source) {

  __asm(".DB \"07>\"");
  g_allocator_assignment_target_signed_word = source;
  __asm(".DB \"<07\"");
}

void allocatorRaPolicyAssignmentZeroExtend(u8 source) {

  __asm(".DB \"08>\"");
  g_allocator_assignment_target_word = source;
  __asm(".DB \"<08\"");
}

void main(void) {
}

u8 g_allocator_call_c_sink;

u8 allocatorRaCallResultCCallee(u8 value) {
  return value + 3;
}

u8 allocatorRaFunctionCallResultC(u8 value, u8 left, u8 right) {

  u8 out;

  __asm(".DB \"01>\"");
  out = allocatorRaCallResultCCallee(value) ^ (left + right);
  g_allocator_call_c_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

u8 allocatorRaFunctionCallOrResultC(u8 value, u8 left, u8 right) {

  u8 out;

  __asm(".DB \"02>\"");
  out = allocatorRaCallResultCCallee(value) | (left & right);
  g_allocator_call_c_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}
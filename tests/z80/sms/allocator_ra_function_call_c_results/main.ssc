// @BT TEST-02 02 START
// @BT 21 FF FF 39 01 C2 00 C5 D5 DD 21 03 00 DD 39 FD
// @BT 21 00 00 FD 19 FD 4E FB DD 71 FB EB C3 22 01 DD
// @BT 21 00 00 DD 19 DD 6E FC DD 5E FD DD 56 FE 4D DD
// @BT 21 00 00 DD 19 DD 7E FA DD A6 F9 B1 DD 77 F8 DD
// @BT 21 00 C0 FD 21 F8 FF FD 19 FD 7E 00 DD 77 00
// @BT END
u8 g_allocator_call_c_sink;

u8 allocatorRaCallResultCCallee(u8 value) {
  return value + 3;
}

u8 allocatorRaFunctionCallResultC(u8 value, u8 left, u8 right) {

  u8 out;

  __asm(".DB \"01>\"");
  out = allocatorRaCallResultCCallee(value) ^ (left + right);
  g_allocator_call_c_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

u8 allocatorRaFunctionCallOrResultC(u8 value, u8 left, u8 right) {

  u8 out;

  __asm(".DB \"02>\"");
  out = allocatorRaCallResultCCallee(value) | (left & right);
  g_allocator_call_c_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}
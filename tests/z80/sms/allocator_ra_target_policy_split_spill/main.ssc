struct AllocatorRaPolicySplitValue {
  u8 byte_value;
  u16 word_value;
};

struct AllocatorRaPolicySplitValue g_allocator_policy_split_values[8];
u8 g_allocator_policy_split_bytes[256];

u8 allocatorRaPolicySplitByte(u8 index_left, u8 index_right) {

  __asm(".DB \"01>\"");
  g_allocator_policy_split_values[index_left + index_right].byte_value++;
  __asm(".DB \"<01\"");

  return index_left;
}

u16 allocatorRaPolicySplitWord(u8 index_left, u8 index_right) {

  __asm(".DB \"02>\"");
  g_allocator_policy_split_values[index_left + index_right].word_value--;
  __asm(".DB \"<02\"");

  return index_right;
}

u8 allocatorRaPolicySplitNonzero(u8 base_index, u8 write_index) {

  u8 *target;
  u8 out;

  target = &g_allocator_policy_split_bytes[base_index];

  __asm(".DB \"03>\"");
  out = target[0];
  target[write_index] = out + 1;
  __asm(".DB \"<03\"");

  return out;
}

void main(void) {
}
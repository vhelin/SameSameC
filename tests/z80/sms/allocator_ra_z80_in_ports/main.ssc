u8 g_allocator_z80_in_port_sink_a;

u8 allocatorRaZ80InPortA(u8 left, u8 right, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = __z80_in[left + right] ^ mask;
  g_allocator_z80_in_port_sink_a = out;
  __asm(".DB \"<01\"");

  return out;
}

u8 allocatorRaZ80InPortHl(u16 left, u16 right, u8 mask) {

  u8 out;

  __asm(".DB \"02>\"");
  out = __z80_in[left ^ right] ^ mask;
  g_allocator_z80_in_port_sink_a = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}
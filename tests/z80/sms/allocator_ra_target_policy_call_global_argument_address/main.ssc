u8 g_allocator_call_global_byte;
u16 g_allocator_call_global_word;
s8 g_allocator_call_global_signed;
u8 g_allocator_call_global_unsigned;
u16 g_allocator_call_global_narrowed;
u16 g_allocator_call_global_sink;

void allocatorRaPolicyCallGlobalCacheSink(u8 first, u8 global_byte, u8 middle, u16 global_word, u8 last) {

  g_allocator_call_global_sink = first ^ global_byte ^ middle ^ global_word ^ last;
}

void allocatorRaPolicyCallGlobalTransportSink(s16 signed_word, u16 unsigned_word, u8 narrowed_word) {

  g_allocator_call_global_sink = signed_word ^ unsigned_word ^ narrowed_word;
}

void allocatorRaPolicyCallGlobalCache(u8 first, u8 middle, u8 last) {

  __asm(".DB \"01>\"");
  allocatorRaPolicyCallGlobalCacheSink(first, g_allocator_call_global_byte, middle, g_allocator_call_global_word, last);
  __asm(".DB \"<01\"");
}

void allocatorRaPolicyCallGlobalTransport(void) {

  __asm(".DB \"02>\"");
  allocatorRaPolicyCallGlobalTransportSink(g_allocator_call_global_signed, g_allocator_call_global_unsigned, g_allocator_call_global_narrowed);
  __asm(".DB \"<02\"");
}

void main(void) {
}
u16 g_candidate_fallback_plan_word_target = 0;

u8 allocatorRaCoreCandidateFallbackPath(u8 a, u8 b, u8 c, u8 d) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (a + b) + (c + d);
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaCoreCandidateFallbackConflict(u16 a, u16 b, u16 c) {

  u16 out;

  __asm(".DB \"02>\"");
  out = (a + b) + (~c);
  g_candidate_fallback_plan_word_target = out;
  __asm(".DB \"<02\"");

  return g_candidate_fallback_plan_word_target;
}

u16 allocatorRaCoreCandidateFallbackUnsupported(u16 value, u16 left, u16 right) {

  u16 out;

  __asm(".DB \"03>\"");
  out = value << (left + right);
  g_candidate_fallback_plan_word_target = out;
  __asm(".DB \"<03\"");

  return out;
}

void main(void) {
}

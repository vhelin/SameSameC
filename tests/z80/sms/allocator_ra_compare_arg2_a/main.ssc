u8 allocatorRaCompareArg2A(u8 a, u8 b, u8 c) {

  __asm(".DB \"01>\"");
  switch (c) {
  case a + b:
    c = c + 1;
  }
  __asm(".DB \"<01\"");

  return c;
}


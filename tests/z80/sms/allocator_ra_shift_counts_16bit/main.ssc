u16 g_allocator_shift_count_16_sink_hl;

u16 allocatorRaShiftLeftCountBc(u16 value, u16 left, u16 right) {

  u16 out;

  __asm(".DB \"01>\"");
  out = value << (left + right);
  g_allocator_shift_count_16_sink_hl = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaShiftRightCountBc(u16 value, u16 left, u16 right) {

  u16 out;

  __asm(".DB \"02>\"");
  out = value >> (left + right);
  g_allocator_shift_count_16_sink_hl = out;
  __asm(".DB \"<02\"");

  return out;
}

u16 constantWordShiftRightThree(u16 value) {

  u16 out;

  __asm(".DB \"03>\"");
  out = value >> 3;
  __asm(".DB \"<03\"");
  return out;
}

u16 constantWordShiftLeftFifteen(u16 value) {

  u16 out;

  __asm(".DB \"04>\"");
  out = value << 15;
  __asm(".DB \"<04\"");
  return out;
}

u16 constantWordShiftRightFifteen(u16 value) {

  u16 out;

  __asm(".DB \"05>\"");
  out = value >> 15;
  __asm(".DB \"<05\"");
  return out;
}

u16 constantWordShiftRightEight(u16 value) {

  u16 out;

  __asm(".DB \"06>\"");
  out = value >> 8;
  __asm(".DB \"<06\"");
  return out;
}

u16 constantWordShiftLeftThree(u16 value) {

  u16 out;

  __asm(".DB \"07>\"");
  out = value << 3;
  __asm(".DB \"<07\"");
  return out;
}

u16 constantWordShiftRightSixteen(u16 value) {

  u16 out;

  __asm(".DB \"08>\"");
  out = value >> 16;
  __asm(".DB \"<08\"");
  return out;
}

u16 constantWordShiftSignedByte(s8 value) {

  u16 widened = value;
  u16 out;

  __asm(".DB \"09>\"");
  out = widened >> 8;
  __asm(".DB \"<09\"");
  return out;
}

u16 constantWordShiftRightFullCount(u16 value) {

  u16 out;

  __asm(".DB \"10>\"");
  out = value >> 256;
  __asm(".DB \"<10\"");
  return out;
}


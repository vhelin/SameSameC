u16 g_allocator_array_read_bc_base_hl_index_sink;

u16 allocatorRaArrayReadBcBaseHlIndex(u16 *source, u16 left, u16 right, u16 mask) {

  u16 out;

  __asm(".DB \"01>\"");
  out = source[left ^ right] ^ mask;
  g_allocator_array_read_bc_base_hl_index_sink = out;
  __asm(".DB \"<01\"");

  return out;
}


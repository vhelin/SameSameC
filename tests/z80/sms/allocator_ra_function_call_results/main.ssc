u8 g_allocator_call_result_sink_a;
u16 g_allocator_call_result_sink_hl;

u8 allocatorRaCallResultCalleeA(u8 value) {
  return value + 3;
}

u16 allocatorRaCallResultCalleeHl(u16 value) {
  return value + 0x0103;
}

u8 allocatorRaFunctionCallResultA(u8 value, u8 mask) {
  u8 out;

  __asm(".DB \"01>\"");
  out = allocatorRaCallResultCalleeA(value) ^ mask;
  g_allocator_call_result_sink_a = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaFunctionCallResultHl(u16 value, u16 mask) {
  u16 out;

  __asm(".DB \"02>\"");
  out = allocatorRaCallResultCalleeHl(value) ^ mask;
  g_allocator_call_result_sink_hl = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}
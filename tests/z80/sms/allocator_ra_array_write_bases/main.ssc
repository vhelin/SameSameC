struct AllocatorRaArrayWriteBaseStruct {
  u8 pad;
  u8 byte_value;
  u16 word_value;
};

struct AllocatorRaArrayWriteBaseStruct g_allocator_array_write_base_struct;

u8 allocatorRaArrayWriteBaseStructA(u8 left, u8 right) {

  __asm(".DB \"01>\"");
  g_allocator_array_write_base_struct.byte_value = left + right;
  __asm(".DB \"<01\"");

  return left;
}

u16 allocatorRaArrayWriteBaseStructHl(u16 left, u16 right) {

  __asm(".DB \"02>\"");
  g_allocator_array_write_base_struct.word_value = left ^ right;
  __asm(".DB \"<02\"");

  return left;
}

void main(void) {
}
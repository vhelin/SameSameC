u8 g_allocator_array_init_copy_location_sink_a;
u16 g_allocator_array_init_copy_location_sink_hl;

u8 allocatorRaArrayInitCopyLocationA(u8 seed, u8 mask) {

  u8 values[6] = { 1, 2, 3, 4, seed, 6 };
  u8 out;

  __asm(".DB \"01>\"");
  out = values[0] + values[1];
  out = out + values[2];
  out = out + values[3];
  out = out + values[4];
  out = out ^ values[5];
  out = out ^ mask;
  g_allocator_array_init_copy_location_sink_a = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaArrayInitCopyLocationHl(u16 seed, u16 mask) {

  u16 values[6] = { 0x0102, 0x0304, 0x0506, 0x0708, seed, 0x090a };
  u16 out;

  __asm(".DB \"02>\"");
  out = values[0] + values[1];
  out = out + values[2];
  out = out + values[3];
  out = out + values[4];
  out = out ^ values[5];
  out = out ^ mask;
  g_allocator_array_init_copy_location_sink_hl = out;
  __asm(".DB \"<02\"");

  return out;
}


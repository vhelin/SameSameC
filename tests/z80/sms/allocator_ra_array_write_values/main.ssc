u8 g_allocator_array_write_values_a[16];
u16 g_allocator_array_write_values_hl[16];

u8 allocatorRaArrayWriteValueA(u8 index, u8 left, u8 right) {

  __asm(".DB \"01>\"");
  g_allocator_array_write_values_a[index] = left + right;
  __asm(".DB \"<01\"");

  return left;
}

u16 allocatorRaArrayWriteValueHl(u8 index, u16 left, u16 right) {

  __asm(".DB \"02>\"");
  g_allocator_array_write_values_hl[index] = left ^ right;
  __asm(".DB \"<02\"");

  return left;
}

u8 allocatorRaZ80OutWriteValueA(u8 port, u8 left, u8 right) {

  __asm(".DB \"03>\"");
  __z80_out[port] = left + right;
  __asm(".DB \"<03\"");

  return left;
}

void main(void) {
}
// @BT TEST-02 02 START
// @BT DD 21 00 00 DD 19 DD 6E F9 DD 66 FA DD 4E F7 DD
// @BT 46 F8 09 DD 4E F5 DD 46 F6 79 EE FF 4F 78 EE FF
// @BT 47 09 DD 75 F3 DD 74 F4 DD 21 01 C0 FD 21 F3 FF
// @BT FD 19 FD 7E 00 DD 77 00 FD 7E 01 DD 77 01
// @BT END

u8 g_allocator_target_policy_byte_sink;
u16 g_allocator_target_policy_word_sink;

u8 allocatorRaTargetPolicyByte(u8 a, u8 b, u8 c, u8 d, u8 e, u8 f, u8 mask) {

  u8 out;

  __asm(".DB \"01>\"");
  out = (a + b) ^ ((c + d) ^ (e + f));
  out = out ^ mask;
  g_allocator_target_policy_byte_sink = out;
  __asm(".DB \"<01\"");

  return out;
}

u16 allocatorRaTargetPolicyWord(u16 a, u16 b, u16 c) {

  u16 out;

  __asm(".DB \"02>\"");
  out = (a + b) + (~c);
  g_allocator_target_policy_word_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}

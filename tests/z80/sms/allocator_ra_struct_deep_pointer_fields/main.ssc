struct AllocatorRaStructDeepPointerLeaf {
  u8 pad;
  u8 byte_value;
  u16 word_value;
};

struct AllocatorRaStructDeepPointerMiddle {
  u8 pad;
  struct AllocatorRaStructDeepPointerLeaf *leaf;
};

struct AllocatorRaStructDeepPointerRoot {
  u8 pad;
  struct AllocatorRaStructDeepPointerMiddle *middle;
};

struct AllocatorRaStructDeepPointerLeaf g_allocator_struct_deep_pointer_leaf;
struct AllocatorRaStructDeepPointerMiddle g_allocator_struct_deep_pointer_middle;
struct AllocatorRaStructDeepPointerRoot g_allocator_struct_deep_pointer_root;
struct AllocatorRaStructDeepPointerRoot *g_allocator_struct_deep_pointer_root_ptr;
u16 g_allocator_struct_deep_pointer_sink_hl;

u8 allocatorRaStructDeepPointerFieldWriteA(u8 value_left, u8 value_right) {

  __asm(".DB \"01>\"");
  g_allocator_struct_deep_pointer_root_ptr->middle->leaf->byte_value = value_left + value_right;
  __asm(".DB \"<01\"");

  return value_left;
}

u16 allocatorRaStructDeepPointerFieldReadHl(u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = g_allocator_struct_deep_pointer_root_ptr->middle->leaf->word_value ^ mask;
  g_allocator_struct_deep_pointer_sink_hl = out;
  __asm(".DB \"<02\"");

  return out;
}

void main(void) {
}
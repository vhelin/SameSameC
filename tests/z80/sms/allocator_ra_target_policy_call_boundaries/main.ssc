u8 g_allocator_policy_boundary_byte_sink;
u16 g_allocator_policy_boundary_word_sink;

void allocatorRaPolicyBoundaryVoidCallee(u8 value) {
  g_allocator_policy_boundary_byte_sink = value;
}

u16 allocatorRaPolicyBoundaryWordCallee(u16 value) {
  return value + 0x0103;
}

void allocatorRaPolicyBoundaryVoidCall(u8 left, u8 right) {

  __asm(".DB \"01>\"");
  allocatorRaPolicyBoundaryVoidCallee(left + right);
  __asm(".DB \"<01\"");
}

u16 allocatorRaPolicyBoundaryValueCall(u16 value, u16 mask) {

  u16 out;

  __asm(".DB \"02>\"");
  out = allocatorRaPolicyBoundaryWordCallee(value) ^ mask;
  g_allocator_policy_boundary_word_sink = out;
  __asm(".DB \"<02\"");

  return out;
}

void allocatorRaPolicyBoundaryPlainReturn(u8 condition) {

  __asm(".DB \"03>\"");
  if (condition) {
    return;
  }
  g_allocator_policy_boundary_byte_sink = condition;
  __asm(".DB \"<03\"");
}

u16 allocatorRaPolicyBoundaryReturnValue(u16 condition, u16 value) {

  __asm(".DB \"04>\"");
  if (condition) {
    return condition + value;
  }
  __asm(".DB \"<04\"");

  return value;
}


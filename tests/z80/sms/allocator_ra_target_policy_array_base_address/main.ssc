struct AllocatorRaPolicyArrayBaseStruct {
  u8 pad;
  u8 value;
};

u8 *g_allocator_array_base_pointer;
u8 g_allocator_array_base_sink;
struct AllocatorRaPolicyArrayBaseStruct g_allocator_array_base_struct;

void allocatorRaPolicyArrayBaseGlobalRead(u8 index) {

  __asm(".DB \"01>\"");
  g_allocator_array_base_sink = g_allocator_array_base_pointer[index];
  __asm(".DB \"<01\"");
}

void allocatorRaPolicyArrayBaseGlobalWrite(u8 index, u8 value) {

  __asm(".DB \"02>\"");
  g_allocator_array_base_pointer[index] = value;
  __asm(".DB \"<02\"");
}

void allocatorRaPolicyArrayBaseNearRead(u8 *source, u8 index) {

  __asm(".DB \"03>\"");
  g_allocator_array_base_sink = source[index];
  __asm(".DB \"<03\"");
}

void allocatorRaPolicyArrayBaseNearWrite(u8 *target, u8 index, u8 value) {

  __asm(".DB \"04>\"");
  target[index] = value;
  __asm(".DB \"<04\"");
}

void allocatorRaPolicyArrayBaseFarRead(u8 *argument, u8 index) {

  u8 padding[140];
  u8 *source;

  source = argument;
  g_allocator_array_base_pointer = &padding[139];
  __asm(".DB \"05>\"");
  g_allocator_array_base_sink = source[index];
  __asm(".DB \"<05\"");
}

void allocatorRaPolicyArrayBaseFarWrite(u8 index, u8 value) {

  u8 padding[140];
  u8 target[6];

  g_allocator_array_base_pointer = &padding[139];
  __asm(".DB \"06>\"");
  target[index] = value;
  g_allocator_array_base_sink = target[index];
  __asm(".DB \"<06\"");
}

void allocatorRaPolicyArrayBaseRetainedRead(void) {

  __asm(".DB \"07>\"");
  g_allocator_array_base_sink = g_allocator_array_base_struct.value;
  __asm(".DB \"<07\"");
}

void allocatorRaPolicyArrayBaseRetainedWrite(u8 value) {

  __asm(".DB \"08>\"");
  g_allocator_array_base_struct.value = value;
  __asm(".DB \"<08\"");
}

void main(void) {
}
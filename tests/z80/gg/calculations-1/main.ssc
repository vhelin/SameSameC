__asm(".sdsctag 1.0, \"TEST\", \"GG Calculations 1\", \"Ville Helin\"",
      ".smsheader", "regioncode 6", "romsize $e", ".endsms");

const u8 g_calculationGameGear = 1;
#include "calculation_display.ssc"
#include "calculation_arithmetic_1.ssc"

void calculateAndPrint3(u8 *chars, u8 one, u8 zero);
void calculateAndPrint4(u8 *chars, u8 one, u8 zero);
u16 calculationPackedCrc(u8 *bytes);

void calculateAndPrintGameGear(u8 one) {

  u8 chars[80];
  u8 unpacked[256];
  u8 *mapper = 0xFFFF;
  u16 result;

  g_calculationRow = 2;
  mapper[0] = 2;
  calculateAndPrint3(chars, one, 1 - one);
  mapper[0] = 3;
  calculateAndPrint4(chars, one, 1 - one);
  mapper[0] = 1;
  result = calculationPackedCrc(unpacked);
  printCalculationLine(chars, 0, 0, 0xCC7D, result, result, result);
}

void main(void) {

  init();
  __z80_out[0xBF] = 0xC0;
  __z80_out[0xBF] = 0x81;
  printCalculationHeading(1);
  calculateAndPrintGameGear(1);
  while (1)
    ;
}

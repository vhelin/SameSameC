void printCalculationLine(u8 *chars, u8 low, u8 high, u16 expected, u16 first, u16 second, u16 third);
u16 calculationMultiplyAdd(u16 value, u16 multiplier, u16 addend);
u16 calculationXorRoundTrip(u16 value, u16 mask);
u16 calculationQuotientRoundTrip(u16 value, u16 divisor);

void calculateAndPrint3(u8 *chars, u8 one, u8 zero) {

  u16 value = 34000;
  u8 divisor = 123;
  u16 result;

  result = ((value + one - one) / (divisor | zero)) | (one - zero);
  printCalculationLine(chars, 0, 0, 0x0115, result, result, result);
  result = calculationMultiplyAdd(0x1234, 3, zero);
  result = calculationXorRoundTrip(calculationQuotientRoundTrip(result, 19), 0x0FF0);
  printCalculationLine(chars, 0, 0, 0x369C, result, result, result);
  result = calculationMultiplyAdd(0x0400, 0x0010, one);
  result = calculationQuotientRoundTrip(calculationXorRoundTrip(result, 0xAAAA), 23);
  printCalculationLine(chars, 0, 0, 0x4001, result, result, result);
  result = calculationXorRoundTrip(calculationQuotientRoundTrip(0x2D2D << one, 29), 0x3333);
  printCalculationLine(chars, 0, 0, 0x5A5A, result, result, result);
}

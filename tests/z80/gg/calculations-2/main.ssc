void convertNumbersToChars16(u16 value, u8 *chars, u8 *index) {

  u8 j = index[0];
  u8 v;

  v = (value >> 12) & 0xF;
  if (v < 10)
    v += 0x10;
  else
    v += 0x17;
  chars[j++] = v;
  chars[j++] = 0x00;

  v = (value >> 8) & 0xF;
  if (v < 10)
    v += 0x10;
  else
    v += 0x17;
  chars[j++] = v;
  chars[j++] = 0x00;

  v = (value >> 4) & 0xF;
  if (v < 10)
    v += 0x10;
  else
    v += 0x17;
  chars[j++] = v;
  chars[j++] = 0x00;

  v = value & 0xF;
  if (v < 10)
    v += 0x10;
  else
    v += 0x17;
  chars[j++] = v;
  chars[j++] = 0x00;

  index[0] = j;
}

static const u8 g_numberToCharacterLUT[] = {
  0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, // 0-9
  0x21, 0x22, 0x23, 0x24, 0x25, 0x26                          // A-F
};

void convertNumbersToChars16QUICK(u16 value, u8 **chars) {

  u8 *ptr = chars[0];
  u8 v;

  v = g_numberToCharacterLUT[value & 0xF];
  ptr[6] = v;
  ptr[7] = 0x00;

  value >>= 4;
  v = g_numberToCharacterLUT[value & 0xF];
  ptr[4] = v;
  ptr[5] = 0x00;

  value >>= 4;
  v = g_numberToCharacterLUT[value & 0xF];
  ptr[2] = v;
  ptr[3] = 0x00;

  value >>= 4;
  v = g_numberToCharacterLUT[value & 0xF];
  ptr[0] = v;
  ptr[1] = 0x00;

  chars[0] = ptr + 8;
}

void printCalculationValues(u8 *chars, u8 addressLow, u8 addressHigh, u16 *values, u8 count) {

  u8 index = 0;
  u8 column;
  u8 i;
  u16 address;

  for (column = 0; column < count; column++) {
    if (column != 0) {
      chars[index++] = 0;
      chars[index++] = 0;
      chars[index++] = 0x1D;
      chars[index++] = 0;
      chars[index++] = 0;
      chars[index++] = 0;
    }
    chars[index++] = 0x04;
    chars[index++] = 0;
    convertNumbersToChars16(values[column], chars, &index);
  }
  if (g_calculationGameGear != 0) {
    address = 0x3800 + (g_calculationRow + 3) * 64 + 12;
    addressLow = address;
    addressHigh = (address >> 8) | 0x40;
    g_calculationRow++;
  }
  __z80_out[0xBF] = addressLow;
  __z80_out[0xBF] = addressHigh;
  for (i = 0; i < index; i++)
    __z80_out[0xBE] = chars[i];
}

void printCalculationLine(u8 *chars, u8 addressLow, u8 addressHigh, u16 expected, u16 first, u16 second, u16 third) {

  u16 values[4];
  u8 count = 4;

  values[0] = expected;
  values[1] = first;
  values[2] = second;
  values[3] = third;
  if (g_calculationGameGear != 0) {
    count = 2;
    values[1] = third;
  }
  printCalculationValues(chars, addressLow, addressHigh, values, count);
}

void printCalculationPair(u8 *chars, u8 row, u16 expected, u16 actual) {

  u16 values[2];
  u16 address = 0x3800 + row * 64;

  values[0] = expected;
  values[1] = actual;
  g_calculationRow = row;
  printCalculationValues(chars, address, (address >> 8) | 0x40, values, 2);
}

void printCalculationLabel(u8 row, u8 *text) {

  u16 address = 0x3800 + row * 64;
  u8 i;

  if (g_calculationGameGear != 0)
    address += 3 * 64 + 12;
  __z80_out[0xBF] = address;
  __z80_out[0xBF] = (address >> 8) | 0x40;
  for (i = 0; text[i] != 0; i++) {
    __z80_out[0xBE] = text[i] - 32;
    __z80_out[0xBE] = 0;
  }
}

void printCalculationHeading(u8 number) {

  const u8 title[] = { 67,65,76,67,85,76,65,84,73,79,78,83,32,0 };
  const u8 legend[] = { 69,88,80,69,67,84,69,68,32,61,32,65,67,84,85,65,76,0 };

  printCalculationLabel(0, title);
  __z80_out[0xBE] = 0x10 + number;
  __z80_out[0xBE] = 0;
  printCalculationLabel(1, legend);
}
u16 calculationProductRestore(u16 value, u16 multiplier, u16 remainder) {

  u16 encoded = value * multiplier + remainder;
  u16 quotient = encoded / multiplier;
  u16 residue = encoded % multiplier;
  return quotient + residue - remainder;
}

u16 calculationShiftRestore(u16 value, u16 shift, u16 mask) {

  u16 encoded = (value << shift) ^ mask;
  encoded ^= mask;
  return encoded >> shift;
}

u16 calculationPartitionRestore(u16 value, u16 divisor, u16 mask) {

  u16 quotient = value / divisor;
  u16 remainder = value % divisor;
  u16 restored = quotient * divisor + remainder;
  restored ^= mask;
  return restored ^ mask;
}

u16 calculationArrayWorkload(u16 seed, u16 count, u8 *bytes) {

  u16 values[16];
  u16 i;
  u16 j;
  u16 pass;
  u16 mixed;
  u16 checksum = seed & 0x1FFF;

  for (i = 0; i < count; i++) {
    values[i] = (seed + i * 73) & 0x1FFF;
    bytes[i] = (seed >> 3) + i * 11;
  }

  for (pass = 0; pass < 3; pass++) {
    for (i = 0; i < count; i++) {
      j = (i + pass + 1) % count;
      mixed = calculationPartitionRestore(values[j] + bytes[i], 17 + pass, seed);
      if ((mixed & 1) == 0)
        mixed = (mixed >> 1) + values[i];
      else
        mixed = (mixed ^ seed) + i * 7;
      values[i] = calculationProductRestore(mixed & 0x1FFF, 3, pass);
      values[i] = calculationShiftRestore(values[i], 1, seed);
      bytes[i] = values[i] ^ (values[i] >> 8) ^ bytes[j];
    }
  }

  for (i = 0; i < count; i++)
    checksum = (checksum + values[i] + bytes[i]) & 0x1FFF;
  return checksum;
}

void calculateAndPrintComplexBank1(u8 *chars, u8 one, u8 zero);
void calculateAndPrintComplexBank2(u8 *chars, u8 one, u8 zero);
void calculateAndPrintComplexBank3(u8 *chars, u8 one, u8 zero);

void calculateAndPrintGameGear(u8 one) {

  u8 chars[80];
  u8 *mapper = 0xFFFF;
  u16 result;

  g_calculationRow = 2;
  result = calculationArrayWorkload(0x47C1, 16, chars);
  printCalculationLine(chars, 0, 0, 0x1FE6, result, result, result);
  mapper[0] = 2;
  calculateAndPrintComplexBank2(chars, one, 1 - one);
  mapper[0] = 3;
  calculateAndPrintComplexBank3(chars, one, 1 - one);
  mapper[0] = 1;
  calculateAndPrintComplexBank1(chars, one, 1 - one);
}

void main(void) {

  init();
  __z80_out[0xBF] = 0xC0;
  __z80_out[0xBF] = 0x81;
  printCalculationHeading(2);
  calculateAndPrintGameGear(1);
  while (1)
    ;
}

__asm(".smsheader", "regioncode 6", "romsize $e", ".endsms");

const u8 g_calculationGameGear = 1;
__asm(".sdsctag 1.0, \"TEST\", \"Calculations 3\", \"Ville Helin\"");

u16 calculationCrc16(u8 *bytes, u16 length) {

  u16 crc = 0xFFFF;
  u16 i;
  u16 bit;

  for (i = 0; i < length; i++) {
    crc ^= bytes[i] << 8;
    for (bit = 0; bit < 8; bit++) {
      if ((crc & 0x8000) != 0)
        crc = (crc << 1) ^ 0x1021;
      else
        crc <<= 1;
    }
  }
  return crc;
}
// Font/VDP setup: https://www.smspower.org/maxim/HowToProgram/Lesson1AllOnOnePage
// GG's 20x18 viewport starts at tile (6,3) in the SMS name table.
u8 g_calculationRow;


void init(void) {

  u16 i;

  const u8 vdpData[] = { 0x04,0x80,0x00,0x81,0xff,0x82,0xff,0x85,0xff,0x86,0xff,0x87,0x00,0x88,0x00,0x89,0xff,0x8a };

  // set up VDP
  for (i = 0; i < sizeof(vdpData); i++)
    __z80_out[0xBF] = vdpData[i];

  // clear VRAM
  __z80_out[0xBF] = 0x00;
  __z80_out[0xBF] = 0x40;
  for (i = 0; i < 1024*16; i++)
    __z80_out[0xBE] = 0x00;

  const u8 paletteData[] = { 0x00,0x3f };
  const u8 paletteGameGear[] = { 0x00,0x00,0xff,0x0f };

  // load palette
  __z80_out[0xBF] = 0x00;
  __z80_out[0xBF] = 0xC0;
  if (g_calculationGameGear != 0) {
    for (i = 0; i < sizeof(paletteGameGear); i++)
      __z80_out[0xBE] = paletteGameGear[i];
  }
  else {
    for (i = 0; i < sizeof(paletteData); i++)
      __z80_out[0xBE] = paletteData[i];
  }

